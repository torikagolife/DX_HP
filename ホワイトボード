/**
 * 【保存機能】ボタンが押された時の処理（ダウンロード、削除、保存）
 */
function processPostback(userId, postbackData, accessToken) {
  // dataの文字列（例: "ward=0&fileId=xxxxx"）をパースする
  const params = {};
  postbackData.split('&').forEach(pair => {
    const [key, value] = pair.split('=');
    params[key] = decodeURIComponent(value);
  });
  
  let targetWard = params['ward'];
  const fileId = params['fileId'];
  
  // ★安全のため数字で受け取ったデータを元の病棟名に変換
  const wardMap = {
    '0': '回復期病棟',
    '1': '１階病棟',
    '2': '東病棟',
    '3': '西病棟'
  };
  if (wardMap[targetWard]) {
    targetWard = wardMap[targetWard];
  }
  
  const FOLDER_IDS = {
    '回復期病棟': props.getProperty('FOLDER_ID_0'),
    '１階病棟': props.getProperty('FOLDER_ID_1'),
    '東病棟': props.getProperty('FOLDER_ID_2'),
    '西病棟': props.getProperty('FOLDER_ID_3')
  };
  
  const folderId = FOLDER_IDS[targetWard];
  
  if (targetWard && folderId && fileId) {
    // LINE WORKSから画像のバイナリデータを取得
    const imageBlob = downloadLineWorksAttachment(fileId, accessToken);
    
    if (imageBlob) {
      const fileName = targetWard + '_最新.jpg';
      imageBlob.setName(fileName);
      
      // 既存の古いファイルを削除して、新しいファイルを保存する
      saveLatestImageAndSaveSpace(folderId, imageBlob, fileName);
      
      sendMessagePayload(userId, { content: { type: "text", text: targetWard + "のホワイトボード写真を更新しました！古い写真は削除されました。" } }, accessToken);
    } else {
      sendMessagePayload(userId, { content: { type: "text", text: "画像のダウンロードに失敗しました。もう一度お試しください。" } }, accessToken);
    }
  }
}

/**
 * プライベートキーの改行コードやスペースの歪みを自動修復する関数
 */
function repairPrivateKey(key) {
  if (!key) return "";
  const header = "-----BEGIN PRIVATE KEY-----";
  const footer = "-----END PRIVATE KEY-----";
  
  let normalizedKey = key.replace(/\\n/g, '\n').replace(/\\r/g, '');
  
  if (normalizedKey.indexOf(header) !== -1 && normalizedKey.indexOf(footer) !== -1) {
    let body = normalizedKey.substring(normalizedKey.indexOf(header) + header.length, normalizedKey.indexOf(footer));
    body = body.replace(/\s+/g, ''); 
    let formattedBody = body.match(/.{1,64}/g).join('\n');
    return header + '\n' + formattedBody + '\n' + footer;
  }
  return key;
}

/**
 * LINE WORKSのAPI 2.0を使用してアクセストークン（JWT認証）を生成する
 */
function getAccessToken() {
  const clientId = props.getProperty('CLIENT_ID');
  const clientSecret = props.getProperty('CLIENT_SECRET');
  const serviceAccount = props.getProperty('SERVICE_ACCOUNT');
  // 成功コードの修復ロジックを適用
  const privateKey = repairPrivateKey(props.getProperty('PRIVATE_KEY')); 
  
  const header = {
    alg: 'RS256',
    typ: 'JWT'
  };
  
  const now = Math.floor(Date.now() / 1000);
  const claim = {
    iss: clientId,
    sub: serviceAccount,
    iat: now,
    exp: now + 3600 // 1時間有効
  };
  
  const signatureInput = Utilities.base64EncodeWebSafe(JSON.stringify(header)) + '.' + Utilities.base64EncodeWebSafe(JSON.stringify(claim));
  const signature = Utilities.computeRsaSha256Signature(signatureInput, privateKey);
  const jwt = signatureInput + '.' + Utilities.base64EncodeWebSafe(signature);
  
  const url = 'https://auth.worksmobile.com/oauth2/v2.0/token';
  const payload = {
    assertion: jwt,
    grant_type: 'urn:ietf:params:oauth:grant-type:jwt-bearer',
    client_id: clientId,
    client_secret: clientSecret,
    scope: 'bot'
  };
  
  const options = {
    method: 'post',
    payload: payload
  };
  
  const response = UrlFetchApp.fetch(url, options);
  const json = JSON.parse(response.getContentText());
  return json.access_token;
}

/**
 * LINE WORKSのAPIから添付ファイル（画像）をダウンロードする
 */
function downloadLineWorksAttachment(fileId, accessToken) {
  const botId = props.getProperty('BOT_ID');
  // ★API 2.0の正しいURLへ修正しました
  const url = 'https://www.worksapis.com/v1.0/bots/' + botId + '/attachments/' + fileId;
  
  const options = {
    method: 'get',
    headers: {
      'Authorization': 'Bearer ' + accessToken
    },
    muteHttpExceptions: true
  };
  
  const response = UrlFetchApp.fetch(url, options);
  const responseCode = response.getResponseCode();
  
  if (responseCode === 200) {
    return response.getBlob();
  } else {
    console.error('ファイルダウンロード失敗: ' + response.getContentText());
    return null;
  }
}

/**
 * 古いファイルを削除（ゴミ箱へ移動）し、新しいファイルを保存するコアロジック
 */
function saveLatestImageAndSaveSpace(folderId, newBlob, fileName) {
  const folder = DriveApp.getFolderById(folderId);
  
  // フォルダ内の同名ファイルを検索（過去の最新画像を探す）
  const files = folder.getFilesByName(fileName);
  
  while (files.hasNext()) {
    const file = files.next();
    file.setTrashed(true); // ゴミ箱へ移動
    console.log('古いファイルをゴミ箱に移動しました: ' + file.getName());
  }
  
  // 新しいファイルを保存
  const newFile = folder.createFile(newBlob);
  console.log('新しいファイルを保存しました: ' + newFile.getName());
}

/**
 * 汎用的にメッセージ（Payload）を送信する関数
 */
function sendMessagePayload(userId, payload, accessToken) {
  const botId = props.getProperty('BOT_ID');
  // ★API 2.0の正しいURLへ修正しました
  const url = 'https://www.worksapis.com/v1.0/bots/' + botId + '/users/' + userId + '/messages';
  
  const options = {
    method: 'post',
    contentType: 'application/json',
    headers: {
      'Authorization': 'Bearer ' + accessToken
    },
    payload: JSON.stringify(payload),
    muteHttpExceptions: true
  };
  
  const response = UrlFetchApp.fetch(url, options);
  
  // ★もし送信に失敗した場合はGASのログにエラー内容を出力するように修正しました
  if (response.getResponseCode() !== 200 && response.getResponseCode() !== 201) {
    console.error('Bot送信失敗: ' + response.getContentText());
  }
}
