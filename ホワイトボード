// スクリプトプロパティを取得する準備
const props = PropertiesService.getScriptProperties();

/**
 * LINE WORKSからのWebhookを受け取るメイン関数
 */
function doPost(e) {
  // LINE WORKSからのデータが空の場合は即座に終了
  if (!e || !e.postData || !e.postData.contents) {
    return ContentService.createTextOutput(JSON.stringify({ status: 'ok' })).setMimeType(ContentService.MimeType.JSON);
  }

  try {
    const jsonString = e.postData.contents;
    const data = JSON.parse(jsonString);
    
    // LINE WORKS API 2.0のペイロードからユーザーIDを取得
    const userId = data.source && data.source.userId ? data.source.userId : null;
    
    if (!userId) {
      return ContentService.createTextOutput(JSON.stringify({ status: 'ok' })).setMimeType(ContentService.MimeType.JSON);
    }
    
    // 先にLINE WORKS API 2.0のアクセストークンを自動生成しておく
    const accessToken = getAccessToken();
    
    // -----------------------------------------------------------------
    // 1. テキストメッセージが送信された場合（カルーセル表示）
    // -----------------------------------------------------------------
    if (data.type === 'message' && data.content && data.content.type === 'text') {
      // ★修正：Flex Messageのボタン(message action)からの隠しデータ(postback)がある場合は保存処理へ
      if (data.content.postback) {
        processPostback(userId, data.content.postback, accessToken);
      } else {
        sendWardCarousel(userId, accessToken);
      }
    }
    
    // -----------------------------------------------------------------
    // 2. 画像が送信された場合（確認ボタンを表示して事故を防ぐ）
    // ※確実にキャッチできるよう、fileIdを持つメッセージを判定
    // -----------------------------------------------------------------
    else if (data.type === 'message' && data.content && (data.content.type === 'image' || data.content.fileId)) {
      const fileId = data.content.fileId;
      if (fileId) {
        sendWardSelectionButtons(userId, fileId, accessToken);
      }
    }
    
    // -----------------------------------------------------------------
    // 3. ボタン（Postback）が押された場合（保存と古いファイルの削除処理）
    // -----------------------------------------------------------------
    else if (data.type === 'postback' && data.data) {
      processPostback(userId, data.data, accessToken);
    }
    
    return ContentService.createTextOutput(JSON.stringify({ status: 'ok' })).setMimeType(ContentService.MimeType.JSON);
    
  } catch (error) {
    console.error('エラーが発生しました: ' + error.toString());
    return ContentService.createTextOutput(JSON.stringify({ status: 'error', message: error.toString() })).setMimeType(ContentService.MimeType.JSON);
  }
}

/**
 * 【表示機能】4病棟の画像をカルーセル（横スライド）で送信する
 */
function sendWardCarousel(userId, accessToken) {
  const WARD_NAMES = ['回復期病棟', '１階病棟', '東病棟', '西病棟'];
  const FOLDER_IDS = {
    '回復期病棟': props.getProperty('FOLDER_ID_0'),
    '１階病棟': props.getProperty('FOLDER_ID_1'),
    '東病棟': props.getProperty('FOLDER_ID_2'),
    '西病棟': props.getProperty('FOLDER_ID_3')
  };

  let carouselContents = [];

  WARD_NAMES.forEach(ward => {
    const folderId = FOLDER_IDS[ward];
    const folder = DriveApp.getFolderById(folderId);
    const files = folder.getFilesByName(ward + '_最新.jpg');
    
    // デフォルト画像
    let imageUrl = 'https://dummyimage.com/600x400/cccccc/000000.png&text=No+Image'; 
    let fileIdForLink = '';

    if (files.hasNext()) {
      const file = files.next();
      fileIdForLink = file.getId();
      // ドライブの画像をプレビュー表示するためのURL
      imageUrl = 'https://drive.google.com/uc?export=view&id=' + fileIdForLink; 
    }

    carouselContents.push({
      "type": "bubble",
      "hero": {
        "type": "image",
        "url": imageUrl,
        "size": "full",
        "aspectRatio": "20:13",
        "aspectMode": "cover"
      },
      "body": {
        "type": "box",
        "layout": "vertical",
        "contents": [
          { "type": "text", "text": ward, "weight": "bold", "size": "xl" }
        ]
      },
      "footer": {
        "type": "box",
        "layout": "vertical",
        "contents": [
          {
            "type": "button",
            "action": {
              "type": "uri",
              "label": "画像を拡大して見る",
              // 万が一プレビューが表示されない時のための直リンク
              "uri": fileIdForLink ? "https://drive.google.com/file/d/" + fileIdForLink + "/view" : "https://drive.google.com/"
            }
          }
        ]
      }
    });
  });

  const payload = {
    content: {
      type: "flex",
      altText: "各病棟のホワイトボード状況",
      contents: {
        type: "carousel",
        contents: carouselContents
      }
    }
  };
  
  sendMessagePayload(userId, payload, accessToken);
}

