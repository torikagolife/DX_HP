// 10. リマインド通知機能
// ※GASの「トリガー」設定で、この関数を1分または5分おきに実行してください
// ==========================================
function sendReminders() {
  const ss = getTargetSpreadsheet();
  const settingSheet = ss.getSheetByName("設定");
  const reservationSheet = ss.getSheetByName("予約枠");
  
  if (!settingSheet || !reservationSheet) return;
  
  let todayRemindTimeStr = settingSheet.getRange("C5").getDisplayValue(); // 例: "9:00"
  let justBeforeMins = parseInt(settingSheet.getRange("D5").getValue(), 10);
  
  if (!todayRemindTimeStr) todayRemindTimeStr = "9:00"; 
  if (isNaN(justBeforeMins)) justBeforeMins = 10; 
  
  const now = new Date();
  const todayStr = Utilities.formatDate(now, "Asia/Tokyo", "yyyy/MM/dd");
  const nowMs = now.getTime();
  
  const rData = reservationSheet.getDataRange().getValues();
  const cache = CacheService.getScriptCache();
  
  for (let i = 1; i < rData.length; i++) {
    if (rData[i][4] === "予約済") {
      const resId = rData[i][0];
      const dateVal = rData[i][1];
      const startVal = rData[i][2]; 
      const doctorLineId = rData[i][6]; 
      
      if (!doctorLineId) continue;
      
      let dObj = dateVal instanceof Date ? dateVal : new Date(dateVal);
      if (isNaN(dObj.getTime())) continue;
      
      let rowDateStr = Utilities.formatDate(dObj, "Asia/Tokyo", "yyyy/MM/dd");
      
      // 予約が「今日」の場合のみチェック
      if (rowDateStr === todayStr) {
        
        // 予約開始時間のDateオブジェクトを生成
        let resStartObj = new Date(dObj.getTime());
        if (startVal instanceof Date) {
          resStartObj.setHours(startVal.getHours(), startVal.getMinutes(), 0, 0);
        } else {
          let parts = startVal.toString().split(":");
          resStartObj.setHours(parseInt(parts[0], 10), parseInt(parts[1], 10), 0, 0);
        }
        const resStartMs = resStartObj.getTime();
        
        // 当日リマインド時間のDateオブジェクトを生成
        let todayRemindObj = new Date(dObj.getTime());
        let tParts = todayRemindTimeStr.split(":");
        todayRemindObj.setHours(parseInt(tParts[0], 10), parseInt(tParts[1], 10), 0, 0);
        const todayRemindMs = todayRemindObj.getTime();
        
        // 直前リマインド時間
        const justBeforeMs = resStartMs - (justBeforeMins * 60 * 1000);
        
        // ① 当日リマインド送信判定
        if (nowMs >= todayRemindMs && !cache.get('reminded_today_' + resId)) {
          let text = `【本日リマインド】\n本日 ${Utilities.formatDate(resStartObj, "Asia/Tokyo", "HH:mm")}～ インタビュー予定です。\nよろしくお願いします。`;
          sendWorksMessage(doctorLineId, { "type": "text", "text": text });
          cache.put('reminded_today_' + resId, 'true', 24 * 60 * 60); // 24時間キャッシュ（重複送信防止）
          writeLog(doctorLineId, "当日リマインド", `ID:${resId}`);
        }
        
        // ② 直前リマインド送信判定
        if (nowMs >= justBeforeMs && !cache.get('reminded_justbefore_' + resId)) {
          let text = `【直前リマインド】\nまもなく ${Utilities.formatDate(resStartObj, "Asia/Tokyo", "HH:mm")} よりインタビューが開始されます。\nご準備をお願いします。`;
          sendWorksMessage(doctorLineId, { "type": "text", "text": text });
          cache.put('reminded_justbefore_' + resId, 'true', 24 * 60 * 60); // 重複送信防止
          writeLog(doctorLineId, "直前リマインド", `ID:${resId}`);
        }
      }
    }
  }
}

// ==========================================
// 11. 管理画面（進捗の集計機能）自動更新
// ==========================================
function updateAdminDashboard() {
  const ss = getTargetSpreadsheet();
  let adminSheet = ss.getSheetByName("管理画面");
  if (!adminSheet) {
    adminSheet = ss.insertSheet("管理画面");
  }
  
  const masterSheet = ss.getSheetByName("ドクターマスタ");
  if (!masterSheet) return;
  
  const mData = masterSheet.getDataRange().getValues();
  
  const statuses = ["未予約", "予約済", "ｲﾝﾀﾋﾞｭｰ済", "編集済み", "公開済み"];
  const doctorLists = { "未予約": [], "予約済": [], "ｲﾝﾀﾋﾞｭｰ済": [], "編集済み": [], "公開済み": [] };
  const counts = {};
  statuses.forEach(s => counts[s] = {});
  
  // 動的に「センター」の種類を取得して対応
  let uniqueCenters = new Set();
  for (let j = 1; j < mData.length; j++) {
    let center = mData[j][0];
    if (center) uniqueCenters.add(center);
  }
  let centersArr = Array.from(uniqueCenters);
  if (centersArr.length === 0) centersArr = ["脊椎", "上肢", "下肢", "人工", "総合・専門"];
  
  statuses.forEach(s => {
    centersArr.forEach(c => counts[s][c] = 0);
  });
  
  // マスタのデータを1行ずつ舐めて振り分け
  for (let j = 1; j < mData.length; j++) {
    let row = mData[j];
    let center = row[0] || "不明";
    let docName = row[1]; // B列:医師名
    if (!docName) continue;
    
    // F〜I列のステータス判定（右側が優先度高）
    let isRes = row[5] === "済"; // F列
    let isInt = row[6] === "済"; // G列
    let isEdi = row[7] === "済"; // H列
    let isPub = row[8] === "済"; // I列
    
    let status = "未予約";
    if (isPub) status = "公開済み";
    else if (isEdi) status = "編集済み";
    else if (isInt) status = "ｲﾝﾀﾋﾞｭｰ済";
    else if (isRes) status = "予約済";
    
    doctorLists[status].push(docName);
    
    if (counts[status][center] !== undefined) {
       counts[status][center]++;
    } else {
       counts[status][center] = 1;
    }
  }
  
  // A〜E列：ステータスごとのドクター名リスト出力
  let maxLen = 0;
  statuses.forEach(s => { if (doctorLists[s].length > maxLen) maxLen = doctorLists[s].length; });
  
  let listArray = [];
  listArray.push(statuses); 
  for (let r = 0; r < maxLen; r++) {
    let rowObj = [];
    statuses.forEach(s => {
      rowObj.push(doctorLists[s][r] || "");
    });
    listArray.push(rowObj);
  }
  
  adminSheet.clearContents(); 
  if (listArray.length > 0) {
    adminSheet.getRange(1, 1, listArray.length, 5).setValues(listArray);
  }
  
  // F〜K列：センターごとの集計表出力
  let aggHeader = [""];
  centersArr.forEach(c => aggHeader.push(c));
  let aggArray = [aggHeader];
  
  statuses.forEach(s => {
    let rowObj = [s];
    centersArr.forEach(c => {
      rowObj.push(counts[s][c] || 0);
    });
    aggArray.push(rowObj);
  });
  
  adminSheet.getRange(1, 6, aggArray.length, aggArray[0].length).setValues(aggArray);
}
