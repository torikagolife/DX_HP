// ==========================================
// 7. 予約確定処理
// ==========================================
function executeReservation(userId, targetId) {
  const ss = getTargetSpreadsheet();
  
  // 【新機能】LINE WORKS APIでユーザーのアドレス形式ID(email)を取得
  const userEmail = getUserEmail(userId);
  
  const reservationSheet = ss.getSheetByName("予約枠");
  const rData = reservationSheet.getDataRange().getValues();
  
  // ドクターマスタから医師名を取得 (UUIDではなく取得したアドレスで照合)
  const masterSheet = ss.getSheetByName("ドクターマスタ");
  let doctorName = "不明";
  if (masterSheet) {
    const mData = masterSheet.getDataRange().getValues();
    for (let j = 1; j < mData.length; j++) {
      // D列(インデックス3)のLINE IDが userEmail に含まれるか部分一致で判定（ドメイン違い対策）
      if (mData[j][3] !== "" && userEmail.indexOf(mData[j][3]) !== -1) {
        doctorName = mData[j][1]; // B列: 医師名を取得
        break;
      }
    }
  }

  let reservedSlotInfo = null;
  
  for (let i = 1; i < rData.length; i++) {
    if (rData[i][0] === targetId) {
      if (rData[i][4] !== "空き") {
        sendWorksMessage(userId, { "type": "text", "text": "申し訳ありません。この枠は既に予約されてしまいました。" });
        return;
      }
      reservationSheet.getRange(i + 1, 5).setValue("予約済");
      reservationSheet.getRange(i + 1, 6).setValue(doctorName); // F列(医師)に書き込み
      reservationSheet.getRange(i + 1, 7).setValue(userEmail);  // G列(LINEID)にアドレス形式で書き込み
      
      reservedSlotInfo = {
        date: rData[i][1] instanceof Date ? Utilities.formatDate(rData[i][1], "Asia/Tokyo", "yyyy/MM/dd") : rData[i][1],
        time: (rData[i][2] instanceof Date ? Utilities.formatDate(rData[i][2], "Asia/Tokyo", "HH:mm") : rData[i][2]) + " - " + (rData[i][3] instanceof Date ? Utilities.formatDate(rData[i][3], "Asia/Tokyo", "HH:mm") : rData[i][3]),
        // 完了メッセージ用に開始時間のみを抽出
        startTime: rData[i][2] instanceof Date ? Utilities.formatDate(rData[i][2], "Asia/Tokyo", "HH:mm") : rData[i][2]
      };
      break;
    }
  }

  if (!reservedSlotInfo) return;

  if (masterSheet) {
    const mData = masterSheet.getDataRange().getValues();
    let found = false;
    const reservationDateTimeStr = `${reservedSlotInfo.date} ${reservedSlotInfo.time}`;
    
    for (let j = 1; j < mData.length; j++) {
      if (mData[j][3] !== "" && userEmail.indexOf(mData[j][3]) !== -1) {
        masterSheet.getRange(j + 1, 5).setValue(reservationDateTimeStr); 
        masterSheet.getRange(j + 1, 6).setValue("済"); 
        found = true;
        break;
      }
    }
    
    if (!found) {
      const newRow = ["", doctorName, "", userEmail, reservationDateTimeStr, "済", "", "", "", "", ""];
      masterSheet.appendRow(newRow);
    }
  }

  // 完了メッセージを送信 (スッキリ版に戻す)
  sendWorksMessage(userId, {
    "type": "text",
    "text": `予約完了 ${reservedSlotInfo.date} ${reservedSlotInfo.startTime}～\n※場所は[会議室2]です。場所変更希望の方はお手数ですが場所予約の上、このままチャットに場所記入お願いします。その他伝達事項もあればチャットお願いします`
  });

  // 【追加機能】設定シートのB5以降にあるLINEID宛に通知を送信
  const settingSheet = ss.getSheetByName("設定");
  if (settingSheet) {
    const sLastRow = settingSheet.getLastRow();
    if (sLastRow >= 5) {
      const notifyTargets = settingSheet.getRange(5, 2, sLastRow - 4, 1).getValues().flat().filter(String);
      if (notifyTargets.length > 0) {
        const notifyContent = {
          "type": "text",
          "text": `【新規予約受付】\n対象者: ${userEmail}\n日時: ${reservedSlotInfo.date} ${reservedSlotInfo.startTime}～\nお名前: ${doctorName}\n※備考や伝達事項がある広報委員はコメントすると備考に追記されます`
        };
        notifyTargets.forEach(function(notifyEmail) {
          if (notifyEmail.trim() !== "") {
            sendWorksMessage(notifyEmail.trim(), notifyContent);
            // 広報メンバーへの通知後、そのメアドをキーにして備考入力待ち状態にする
            CacheService.getScriptCache().put('wait_pr_comment_' + notifyEmail.trim(), targetId.toString(), 3600);
          }
        });
      }
    }
  }

  // ログ記録：予約が完了したことを記録
  writeLog(userEmail, "予約確定", `日時: ${reservedSlotInfo.date} ${reservedSlotInfo.startTime}～ / お名前: ${doctorName}`);
  
  // 【新機能】Googleカレンダーに予定を登録
  if (CONFIG.CALENDAR_ID) {
    try {
      const cal = CalendarApp.getCalendarById(CONFIG.CALENDAR_ID);
      if (cal) {
        const timeParts = reservedSlotInfo.time.split(" - ");
        const startDateTime = new Date(reservedSlotInfo.date + " " + timeParts[0]);
        const endDateTime = new Date(reservedSlotInfo.date + " " + timeParts[1]);
        const title = `[ｲﾝﾀﾋﾞｭｰ] ${doctorName} 様`;
        const description = `対象者: ${userEmail}\n担当医: ${doctorName}\n\n【コメント】\n(未入力)\n\n【備考】\n(未入力)`;
        cal.createEvent(title, startDateTime, endDateTime, { description: description });
      }
    } catch(e) {
      console.error("カレンダー登録エラー: " + e.message);
    }
  }
  
  // ドクター本人のコメント受け取り用に一時的にステータスをキャッシュ（1時間有効）
  CacheService.getScriptCache().put('wait_comment_' + userId, targetId.toString(), 3600);
  
  // 管理画面の更新を呼び出し
  updateAdminDashboard();
}

// ==========================================
// 8. LINE WORKS API 通信関連
// ==========================================
function repairPrivateKey(key) {
  if (!key) return "";
  const header = "-----BEGIN PRIVATE KEY-----";
  const footer = "-----END PRIVATE KEY-----";
  let normalizedKey = key.replace(/\\n/g, '\n').replace(/\\r/g, '');
  if (normalizedKey.indexOf(header) !== -1 && normalizedKey.indexOf(footer) !== -1) {
    let body = normalizedKey.substring(normalizedKey.indexOf(header) + header.length, normalizedKey.indexOf(footer));
    body = body.replace(/\s+/g, '');
    let formattedBody = body.match(/.{1,64}/g).join('\n');
    return header + '\n' + formattedBody + '\n' + footer;
  }
  return key;
}

function getAccessToken() {
  var cache = CacheService.getScriptCache();
  // 【修正点】キャッシュキーをV3に変更し、確実に追加権限なしのクリーンなトークンを取り直す
  var token = cache.get('LINEWORKS_TOKEN_V3');
  if (token) return token;

  const privateKey = repairPrivateKey(CONFIG.PRIVATE_KEY);
  const now = Math.floor(Date.now() / 1000);
  const header = { alg: "RS256", typ: "JWT" };

  const payload = {
    iss: CONFIG.CLIENT_ID.trim(),
    sub: CONFIG.SERVICE_ACCOUNT.trim(),
    iat: now,
    exp: now + 3600
  };

  const encodedHeader = Utilities.base64EncodeWebSafe(JSON.stringify(header));
  const encodedPayload = Utilities.base64EncodeWebSafe(JSON.stringify(payload));
  const signingInput = encodedHeader + "." + encodedPayload;

  const signatureBytes = Utilities.computeRsaSha256Signature(signingInput, privateKey);
  const encodedSignature = Utilities.base64EncodeWebSafe(signatureBytes);
  const jwt = signingInput + "." + encodedSignature;

  const response = UrlFetchApp.fetch(
    "https://auth.worksmobile.com/oauth2/v2.0/token", 
    {
      method: "post",
      payload: {
        assertion: jwt,
        grant_type: "urn:ietf:params:oauth:grant-type:jwt-bearer",
        client_id: CONFIG.CLIENT_ID.trim(),
        client_secret: CONFIG.CLIENT_SECRET.trim(),
        // 【重要修正】コンソール画面で設定済みの権限のみを確実に要求するよう修正
        scope: "bot,user.read"
      },
      muteHttpExceptions: true
    }
  );

  const text = response.getContentText();
  if (!text.startsWith("{")) throw new Error("Token取得失敗: " + text);
  
  const json = JSON.parse(text);
  if (!json.access_token) throw new Error(text);

  cache.put('LINEWORKS_TOKEN_V3', json.access_token, 3000);
  return json.access_token;
}

// 【新機能】APIを叩いてユーザー情報を取得する関数
function getUserEmail(userId) {
  var url = "https://www.worksapis.com/v1.0/users/" + userId;
  var options = {
    method: "get",
    headers: {
      Authorization: "Bearer " + getAccessToken()
    },
    muteHttpExceptions: true
  };
  
  var response = UrlFetchApp.fetch(url, options);
  if (response.getResponseCode() === 200) {
    var json = JSON.parse(response.getContentText());
    
    // emailだけでなく他のキーに入っていた場合もカバー
    var emailStr = json.email || json.externalEmail || json.userEmail || "";
    
    if (emailStr) {
      // 取得したメールアドレスの＠より前を取り出し、@torikagoを付ける
      var parts = emailStr.split('@');
      return parts[0] + "@torikago"; 
    }
    return userId; // emailが取得できなければUUIDを返す
  } else {
    console.error("User情報取得失敗: " + response.getContentText());
    return userId; // 取得失敗時は安全のためUUIDを返す
  }
}

function sendWorksMessage(userId, messageContent) {
  var url = "https://www.worksapis.com/v1.0/bots/" + CONFIG.BOT_ID + "/users/" + userId + "/messages";
  var options = {
    method: "post",
    headers: {
      Authorization: "Bearer " + getAccessToken(),
      "Content-Type": "application/json"
    },
    payload: JSON.stringify({
      content: messageContent
    }),
    muteHttpExceptions: true
  };
  var response = UrlFetchApp.fetch(url, options);
  if (response.getResponseCode() !== 200 && response.getResponseCode() !== 201) {
    console.error("Message送信失敗: " + response.getContentText());
  }
}

