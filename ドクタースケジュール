function generateAddressBookMessage(targetTeam) {
  const ss = SpreadsheetApp.openById(PropertiesService.getScriptProperties().getProperty("SPREADSHEET_ID"));
  
  // 1. 設定シートから該当チームの絵文字を取得
  let teamEmoji = "";
  const configSheet = ss.getSheetByName("設定");
  if (configSheet) {
    const configData = configSheet.getDataRange().getValues();
    for (let i = 1; i < configData.length; i++) {
      let teamName = configData[i][0] ? configData[i][0].toString().trim() : "";
      if (teamName === targetTeam) {
        teamEmoji = configData[i][1] ? configData[i][1].toString().trim() : "";
        break;
      }
    }
  }

  // 2. 当日のステータスマップを作成（時間は問わず、一日のスケジュールを格納）
  let currentJST = new Date();
  let targetDateStr = Utilities.formatDate(currentJST, "Asia/Tokyo", "yyyy/MM/dd");

  const locations = ["船橋", "市川", "西船"];
  const statusMap = {};
  
  locations.forEach(loc => {
    const sheet = ss.getSheetByName(`スケジュール${loc}`);
    if(!sheet) return;
    
    const data = sheet.getDataRange().getValues();
    const records = data.slice(1).filter(row => {
      if (!row[0]) return false;
      const d = new Date(row[0]);
      const dStr = `${d.getFullYear()}/${String(d.getMonth()+1).padStart(2, '0')}/${String(d.getDate()).padStart(2, '0')}`;
      return dStr === targetDateStr;
    });
    
    records.forEach(row => {
      const roleFull = row[2] ? row[2].toString() : "";
      const rawDoctor = row[3] ? row[3].toString().trim() : ""; // 表示名
      const parts = roleFull.split("_");
      const category = parts[0]; 
      
      // 拠点名を省略
      let locShort = loc;
      if (loc === "船橋") locShort = "船";
      if (loc === "市川") locShort = "市";
      if (loc === "西船") locShort = "西";

      if (!statusMap[rawDoctor]) statusMap[rawDoctor] = []; // ★配列で初期化

      // ★変更：同じステータスが重複しないようにチェックしてから追加する関数
      let addStatus = (txt, type) => {
        if (!statusMap[rawDoctor].some(s => s.text === txt)) {
          statusMap[rawDoctor].push({ text: txt, type: type });
        }
      };

      // 時間帯に関わらず、すべてのスケジュールを配列に追加
      if (category === "外来午前") {
        addStatus(`[AM]外：${locShort}`, "AM");
      } else if (category === "外来午後") {
        addStatus(`[PM]外：${locShort}`, "PM");
      } else if (category === "回復/救急") {
        addStatus(`回・救`, "KAIKYU");
      } else if (category === "当直") {
        addStatus(`当直`, "TOUCHOKU");
      }
    });
  });

  // 3. ドクターマスタから対象チームの先生のみを抽出
  const masterSheet = ss.getSheetByName("ドクターマスタ");
  const docs = [];
  
  if (masterSheet) {
    const masterData = masterSheet.getDataRange().getValues();
    for (let i = 1; i < masterData.length; i++) {
      const dispName = masterData[i][0] ? masterData[i][0].toString().trim() : ""; // A列
      const accountId = masterData[i][1] ? masterData[i][1].toString().trim() : ""; // B列
      const teamName = masterData[i][2] ? masterData[i][2].toString().trim() : "";  // C列
      const fullName = masterData[i][3] ? masterData[i][3].toString().trim() : "";  // D列
      const ext = masterData[i][4] ? masterData[i][4].toString().trim() : "";       // E列
      
      // LINE WORKSアカウントがあり、かつ選択されたチームに所属している場合
      if (accountId && teamName === targetTeam) {
         let currentStatus = statusMap[dispName] || []; // ★配列で取得
         docs.push({
             dispName: dispName,
             fullName: fullName,
             accountId: accountId,
             ext: ext,
             status: currentStatus
         });
      }
    }
  }

  // 4. アドレス帳メッセージ（Flex）を組み立て
  let boxContents = [];
  
  // チーム名ヘッダー
  boxContents.push({
    type: "text",
    text: `${teamEmoji} ${targetTeam}チーム`,
    weight: "bold",
    size: "lg",
    color: "#2980b9",
    margin: "md"
  });
  boxContents.push({ type: "separator", margin: "md" });
  
  if (docs.length === 0) {
     boxContents.push({ type: "text", text: "このチームには連絡可能なドクターがいません。", margin: "md", wrap: true });
  } else {
     // チーム所属の各ドクター情報（横並びレイアウト）
     docs.forEach(doc => {
         let docRow = {
             type: "box",
             layout: "horizontal",
             margin: "md",
             spacing: "sm",
             contents: []
         };
         
         // 医師名 (D列を優先、無ければA列)
         docRow.contents.push({
             type: "text",
             text: doc.fullName || doc.dispName,
             size: "sm",
             weight: "bold",
             color: "#333333",
             flex: 4,
             gravity: "center"
         });
         
         // ★変更：ステータス表示（spanを展開して1行で色分け複数表示）
         if (doc.status && doc.status.length > 0) {
             let spans = [];
             doc.status.forEach((st, index) => {
                 let fontColor = "#7f8c8d"; // デフォルト
                 if (st.type === "AM") fontColor = "#2980b9"; // 青系
                 if (st.type === "PM") fontColor = "#e74c3c"; // 赤系
                 if (st.type === "KAIKYU") fontColor = "#27ae60"; // 緑色
                 if (st.type === "TOUCHOKU") fontColor = "#8e44ad"; // 紫色
                 
                 // 最後の要素以外は半角スペースを入れて間をあける
                 let textStr = st.text + (index < doc.status.length - 1 ? " " : "");

                 spans.push({
                     type: "span",
                     text: textStr,
                     size: "xxs",
                     color: fontColor,
                     weight: "bold"
                 });
             });

             // textオブジェクトにspanを含めることで必ず1行にまとめる
             docRow.contents.push({
                 type: "text",
                 contents: spans,
                 flex: 3,
                 gravity: "center",
                 align: "center",
                 wrap: true
             });
         } else {
             docRow.contents.push({
                 type: "text",
                 text: " ",
                 flex: 3,
                 size: "xs"
             });
         }
         
         // LINEトークへのリンクボタン
         docRow.contents.push({
             type: "text",
             text: "💬",
             size: "lg",
             action: {
                 type: "uri",
                 uri: `https://line.worksmobile.com/message/send?version=28&emailList=${doc.accountId}`
             },
             flex: 1,
             gravity: "center"
         });
         
         // 内線番号がある場合はTELリンクボタンを追加
         if (doc.ext) {
             docRow.contents.push({
                 type: "text",
                 text: "📞",
                 size: "lg",
                 action: {
                     type: "uri",
                     uri: `tel:${doc.ext}`
                 },
                 flex: 1,
                 gravity: "center",
                 align: "end"
             });
         } else {
             // 見栄えを揃えるための空スペース
             docRow.contents.push({
                 type: "text",
                 text: " ",
                 flex: 1
             });
         }
         
         boxContents.push(docRow);
     });
  }

  // チーム選択に戻るボタンを追加しておくと親切なので追加
  boxContents.push({ type: "separator", margin: "xl" });
  boxContents.push({
    type: "button",
    style: "link",
    height: "sm",
    action: {
      type: "message",
      label: "🔙 チーム選択に戻る",
      text: "連絡先一覧",
      postback: "REQ_TEAM_LIST"
    },
    margin: "md"
  });

  return {
    type: "flex",
    altText: `${targetTeam}チームの連絡先`,
    contents: {
      type: "bubble",
      size: "mega",
      body: {
        type: "box",
        layout: "vertical",
        contents: boxContents
      }
    }
  };
}

// ＝＝＝＝＝ ここから下がLINE WORKS Bot連携用のコードです ＝＝＝＝＝

function doPost(e) {
  if (!e || !e.postData || !e.postData.contents) {
    return ContentService.createTextOutput("OK");
  }

  try {
    const props = PropertiesService.getScriptProperties().getProperties();
    const json = JSON.parse(e.postData.contents);
    const userId = json.source && json.source.userId ? json.source.userId : null;

    if (userId) {
      let targetDateStr = "";
      
      let userText = "";
      if (json.content && json.content.type === "text") {
        userText = json.content.text || "";
      }
      
      let postbackData = "";
      if (json.content && json.content.postback) {
        postbackData = json.content.postback;
        userText += postbackData;
      }

      let normalizedText = userText.replace(/[０-９]/g, function(s) {
        return String.fromCharCode(s.charCodeAt(0) - 0xFEE0);
      }).trim();

      // ★ルーティング処理：リクエスト内容によって返すメッセージを分岐
      let isScheduleRequest = false;
      let targetTeam = "";

      if (postbackData.startsWith("REQ_DATE:")) {
        targetDateStr = postbackData.replace("REQ_DATE:", "");
        isScheduleRequest = true;
      } else if (postbackData.startsWith("REQ_TEAM:")) {
        // チーム選択ボタンが押された場合
        targetTeam = postbackData.replace("REQ_TEAM:", "");
      } else if (postbackData === "REQ_TEAM_LIST") {
        // 「チーム選択に戻る」ボタンが押された場合（このままで下のelseに落ちてメニューが出ます）
      } else if (/^\d{4}$/.test(normalizedText)) {
        // 4桁入力ならスケジュール表示
        let jstYear = Utilities.formatDate(new Date(), "Asia/Tokyo", "yyyy");
        let m = normalizedText.substring(0, 2);
        let d = normalizedText.substring(2, 4);
        targetDateStr = `${jstYear}/${m}/${d}`;
        isScheduleRequest = true;
      } else if (normalizedText === "か" || normalizedText === "カ") {
        // 「か」または「カ」入力なら当日のスケジュール表示
        let targetDate = new Date();
        targetDateStr = Utilities.formatDate(targetDate, "Asia/Tokyo", "yyyy/MM/dd");
        isScheduleRequest = true;
      }
      
      let messageContent;
      if (isScheduleRequest) {
        // 今まで通りの外来スケジュール表示
        messageContent = generateScheduleMessage(targetDateStr);
      } else if (targetTeam !== "") {
        // 選択されたチームのドクター一覧アドレス帳を表示
        messageContent = generateAddressBookMessage(targetTeam);
      } else {
        // 上記以外（何を発言しても）最初はチーム選択メニューを表示
        messageContent = generateTeamListMessage();
      }
      
      sendLineWorksMessageToUser(props, userId, messageContent);
    }
  } catch (error) {
    console.error("Webhook処理エラー: ", error.toString());
  }

  return ContentService.createTextOutput("OK");
}

function sendLineWorksMessageToUser(props, userId, contentObject) {
  const accessToken = getAccessToken(props);
  const url = "https://www.worksapis.com/v1.0/bots/" + props.BOT_ID + "/users/" + userId + "/messages";

  const options = {
    method: "post",
    headers: {
      Authorization: "Bearer " + accessToken,
      "Content-Type": "application/json"
    },
    payload: JSON.stringify({
      content: contentObject
    }),
    muteHttpExceptions: true
  };

  const response = UrlFetchApp.fetch(url, options);

  if (response.getResponseCode() !== 201) {
    throw new Error("Bot送信失敗: " + response.getContentText());
  }
}

function repairPrivateKey(key) {
  if (!key) return "";
  const header = "-----BEGIN PRIVATE KEY-----";
  const footer = "-----END PRIVATE KEY-----";
  
  let normalizedKey = key.replace(/\\n/g, '\n').replace(/\\r/g, '');
  
  if (normalizedKey.indexOf(header) !== -1 && normalizedKey.indexOf(footer) !== -1) {
    let body = normalizedKey.substring(normalizedKey.indexOf(header) + header.length, normalizedKey.indexOf(footer));
    body = body.replace(/\s+/g, ''); 
    let formattedBody = body.match(/.{1,64}/g).join('\n');
    return header + '\n' + formattedBody + '\n' + footer;
  }
  return key;
}

function getAccessToken(props) {
  const privateKey = repairPrivateKey(props.PRIVATE_KEY);
  const now = Math.floor(Date.now() / 1000);
  const header = { alg: "RS256", typ: "JWT" };
  const payload = {
    iss: (props.CLIENT_ID || "").trim(),
    sub: (props.SERVICE_ACCOUNT || "").trim(),
    iat: now,
    exp: now + 3600
  };

  const encodedHeader = Utilities.base64EncodeWebSafe(JSON.stringify(header));
  const encodedPayload = Utilities.base64EncodeWebSafe(JSON.stringify(payload));
  const signingInput = encodedHeader + "." + encodedPayload;
  const signatureBytes = Utilities.computeRsaSha256Signature(signingInput, privateKey);
  const encodedSignature = Utilities.base64EncodeWebSafe(signatureBytes);
  const jwt = signingInput + "." + encodedSignature;

  const response = UrlFetchApp.fetch(
    "https://auth.worksmobile.com/oauth2/v2.0/token",
    {
      method: "post",
      payload: {
        assertion: jwt,
        grant_type: "urn:ietf:params:oauth:grant-type:jwt-bearer",
        client_id: (props.CLIENT_ID || "").trim(),
        client_secret: (props.CLIENT_SECRET || "").trim(),
        scope: "bot"
      },
      muteHttpExceptions: true
    }
  );

  const text = response.getContentText();
  if (!text.startsWith("{")) {
    throw new Error("Token取得失敗: " + text);
  }

  const json = JSON.parse(text);
  if (!json.access_token) {
    throw new Error(text);
  }

  return json.access_token;
}
