function processExcelUpload(fileObj) {
  try {
    const decoded = Utilities.base64Decode(fileObj.base64);
    const blob = Utilities.newBlob(decoded);
    
    // 🌟CSVとして直接読み込む（文字化け対策込み）
    let text = blob.getDataAsString("Shift_JIS");
    if (text.includes('')) { text = blob.getDataAsString("UTF-8"); }
    text = text.replace(/\r\n/g, '\n').replace(/\r/g, '\n');
    
    const values = Utilities.parseCsv(text);
    if (!values || values.length < 4) throw new Error("ファイルの内容が読み込めません。");

    // 年月の抽出
    const row0Str = values[0].join("");
    const yearMatch = row0Str.match(/(\d{4})年/);
    const monthMatch = row0Str.match(/年(\d+)月/);
    const year = yearMatch ? yearMatch[1] : new Date().getFullYear();
    const month = monthMatch ? monthMatch[1] : (new Date().getMonth() + 1);

    // カテゴリと役割の読み込み
    let categories = values[1].map(v => v ? v.toString().replace(/\n/g, "") : "");
    let subCategories = values[2].map(v => v ? v.toString().replace(/\n/g, "") : "");

    let outputData = [];
    for(let r = 3; r < values.length; r++) {
      let day = values[r][0];
      if(!day || isNaN(day)) continue;

      let dateStr = `${year}/${String(month).padStart(2, '0')}/${String(day).padStart(2, '0')}`;

      for(let c = 2; c < values[r].length; c++) {
        let doctorStr = values[r][c] ? values[r][c].toString().trim() : "";
        if(!doctorStr || doctorStr === "NaN") continue;

        let doctorsList = doctorStr.split(/[\/\n]/);
        for (let docName of doctorsList) {
          docName = docName.trim();
          if (!docName) continue;

          let rawCat = categories[c];
          let rawSub = subCategories[c];
          
          let finalAmPm = rawCat.includes("午前") ? "午前" : (rawCat.includes("午後") ? "午後" : "終日");
          let finalRole = rawSub;

          if (rawCat.includes("回復期") || rawCat.includes("救急")) {
            finalRole = "回復・救急";
            finalAmPm = (rawSub.includes("9時") || rawSub === "午前") ? "午前" : "午後";
          } else if (rawCat.includes("残り番") || rawCat.includes("当直")) {
            finalAmPm = "午後";
            finalRole = rawCat.includes("残り番") ? "残り番" : "当直";
          }
          
          outputData.push([dateStr, "船橋", finalAmPm, finalRole, docName]);
        }
      }
    }

    const activeSS = SpreadsheetApp.openById(PropertiesService.getScriptProperties().getProperty("SPREADSHEET_ID"));
    let targetSheet = activeSS.getSheetByName("スケジュール船橋");
    if (!targetSheet) {
      targetSheet = activeSS.insertSheet("スケジュール船橋");
      targetSheet.appendRow(["日付", "拠点", "午前/午後", "役割", "医師名"]);
    }
    
    if (outputData.length > 0) {
      targetSheet.getRange(targetSheet.getLastRow() + 1, 1, outputData.length, 5).setValues(outputData);
    }

    return `🎉 大成功！\n${outputData.length}件をDBに展開しました。`;

  } catch (err) {
    throw new Error("解析エラー: " + err.toString());
  }
}

