// 11. アシスタント判定
// ==================================================================

function matchExpertByText(norm) {
  if (/^[0-9]+$/.test(norm)) {
    const idx = parseInt(norm, 10) - 1;
    return EXPERTS[idx] || null;
  }
  for (const e of EXPERTS) {
    const cands = [e.id, e.name, label(e), ...(e.aliases || [])].map(normalize);
    if (cands.includes(norm)) return e;
  }
  return null;
}

function matchExpertByPostback(pb) {
  if (typeof pb !== "string" || !pb.startsWith("select:")) return null;
  return EXPERT_BY_ID[pb.slice(7)] || null;
}

function isCommand(list, norm) {
  return list.map(normalize).includes(norm);
}

// ==================================================================
// 12. イベント処理
// ==================================================================

async function selectExpert(env, target, scope, state, expert) {
  if (state.expert !== expert.id) {
    state.expert = expert.id;
    await saveState(env, scope, state);
  }
  const history = await loadHistory(env, scope, expert.id);
  const turns = Math.floor(history.length / 2);
  const memo = turns > 0
    ? `\n\n（前回の会話 ${turns}往復分を覚えています。「リセット」で消去できます）`
    : "";
  await sendText(env, target, `${label(expert)}\n\n${expert.greeting}${memo}`, { quick: true });
}

/** 選択を解除してキャラ選択画面へ */
async function backToSelector(env, target, scope, state) {
  if (state.expert) {
    state.expert = null;
    await saveState(env, scope, state);
  }
  await sendSelector(env, target, null);
}

async function handleEvent(env, body) {
  const src = body.source || {};

  // ★ accountId を優先（動作実績のあるGAS版と同じ順序）
  const userId = String(src.accountId || src.userId || "");
  const channelId = src.channelId ? String(src.channelId) : null;

  // Botがトークルームに招待された
  if ((body.type === "join" || body.type === "joined") && channelId) {
    await sendSelector(env, { userId: null, channelId }, null);
    return;
  }

  if (!userId) {
    await recordIssue(env, "no_user_id", { type: body.type || null });
    return;
  }

  const target = { userId, channelId };
  const scope = scopeOf(target);
  const state = await loadState(env, scope);

  // ---- postbackイベント ----
  if (body.type === "postback") {
    const ex = matchExpertByPostback(body.data);
    if (ex) return selectExpert(env, target, scope, state, ex);
    return sendSelector(env, target, state.expert);
  }

  if (body.type !== "message") return; // leave等は無視

  const content = body.content || {};

  // ---- ボタン由来のpostback付きメッセージ ----
  const pbExpert = matchExpertByPostback(content.postback);
  if (pbExpert) return selectExpert(env, target, scope, state, pbExpert);

  // ---- テキスト以外 ----
  if (content.type !== "text") {
    if (!state.expert) return sendSelector(env, target, null);
    return sendText(env, target, MSG.unsupported, { quick: true });
  }

  const rawText = String(content.text || "").trim();
  if (!rawText) return;
  if (rawText.length > MAX_INPUT_CHARS) {
    return sendText(env, target, MSG.tooLong, { quick: true });
  }

  const norm = normalize(rawText);

  // ---- コマンド: ヘルプ ----
  if (isCommand(CMD_HELP, norm)) {
    return sendText(env, target, buildHelp(env), { quick: true });
  }

  // ---- コマンド: メニュー（選択解除 → キャラ選択画面。履歴は残す） ----
  if (isCommand(CMD_MENU, norm)) {
    return backToSelector(env, target, scope, state);
  }

  // ---- コマンド: 全部リセット（全履歴削除 → キャラ選択画面） ----
  if (isCommand(CMD_RESET_ALL, norm)) {
    await deleteAllHistory(env, scope);
    await sendText(env, target, "🗑️ すべてのアシスタントとの会話履歴を削除しました。");
    return backToSelector(env, target, scope, state);
  }

  // ---- コマンド: リセット（今のアシスタントの履歴削除 → キャラ選択画面） ----
  if (isCommand(CMD_RESET, norm)) {
    if (state.expert) {
      const prev = EXPERT_BY_ID[state.expert];
      await deleteHistory(env, scope, prev.id);
      await sendText(env, target, `${label(prev)}との会話履歴を削除しました。`);
    }
    return backToSelector(env, target, scope, state);
  }

  // ---- 名前・番号での切り替え ----
  const textExpert = matchExpertByText(norm);
  if (textExpert) return selectExpert(env, target, scope, state, textExpert);

  // ---- 未選択なら、何を送ってもキャラ選択FLEX ----
  if (!state.expert) return sendSelector(env, target, null);

  const expert = EXPERT_BY_ID[state.expert];

  // ---- コマンド: 現在のアシスタント ----
  if (isCommand(CMD_STATUS, norm)) {
    const h = await loadHistory(env, scope, expert.id);
    return sendText(
      env,
      target,
      `現在のアシスタント: ${label(expert)}\n会話履歴: ${Math.floor(h.length / 2)}往復`,
      { quick: true }
    );
  }

  // ---- 通常会話 ----
  const history = await loadHistory(env, scope, expert.id);
  const answer = await askOpenAI(env, expert, history, rawText);

  if (!answer) {
    return sendText(env, target, MSG.aiError, { quick: true }); // 履歴は汚さない
  }

  const ok = await sendText(env, target, `${label(expert)}\n\n${answer}`, { quick: true });

  if (ok) {
    const next = trimHistory(
      [...history, { role: "user", content: rawText }, { role: "assistant", content: answer }],
      historyTurns(env)
    );
    await saveHistory(env, scope, expert.id, next);
  }
}

// ==================================================================
// 13. ヘルスチェック / 診断
// ==================================================================

const REQUIRED_ENV = [
  "OPENAI_API_KEY",
  "LINEWORKS_BOT_ID",
  "LINEWORKS_CLIENT_ID",
  "LINEWORKS_CLIENT_SECRET",
  "LINEWORKS_SERVICE_ACCOUNT",
  "LINEWORKS_PRIVATE_KEY",
];

function buildHealth(env) {
  const missingEnv = REQUIRED_ENV.filter((k) => !env[k]);
  const kvBound = !!env.BOT_KV;

  const promptNames = [
    "PROMPT_COMMON",
    "PROMPT_COMMON_MEDICAL",
    ...EXPERTS.map((e) => e.promptEnv),
  ];
  const promptSizes = {};
  const missingPrompts = [];
  const promptWarnings = [];

  for (const name of promptNames) {
    const bytes = byteLength(env[name]);
    promptSizes[name] = `${bytes} / ${ENV_VAR_LIMIT_BYTES} bytes`;
    if (!envText(env[name])) missingPrompts.push(name);
    if (bytes > ENV_VAR_WARN_BYTES) promptWarnings.push(`${name} が上限に近い（${bytes} bytes）`);
  }

  return {
    status: missingEnv.length === 0 && kvBound ? "ok" : "misconfigured",
    missingEnv,
    kvBound,
    signatureCheck: env.LINEWORKS_BOT_SECRET ? "有効" : "スキップ中（BOT_SECRET未設定）",
    missingPrompts,
    promptWarnings,
    promptSizes,
    model: env.OPENAI_MODEL || DEFAULT_MODEL,
    historyTurns: historyTurns(env),
    assistants: EXPERTS.map((e) => label(e)),
    hint: "詳しい診断は /diag を開いてください",
  };
}

/** 秘密鍵・トークン・送信を実際に試す診断 */
async function buildDiag(env, testUserId) {
  const result = {
    checkedAt: new Date().toISOString(),
    privateKey: {},
    accessToken: {},
    testSend: null,
    lastIssues: [],
    note: "秘密情報は一切表示しません",
  };

  // --- 秘密鍵 ---
  const format = detectKeyFormat(env.LINEWORKS_PRIVATE_KEY);
  result.privateKey.format = format;
  result.privateKey.formatLabel = {
    pkcs8: "PKCS#8（そのまま使えます）",
    pkcs1: "PKCS#1（自動でPKCS#8に変換します）",
    headerless: "BEGIN/END行なし（BASE64として読み込みます）",
    encrypted: "パスフレーズ付き（使えません。復号してください）",
    empty: "未設定",
  }[format] || format;

  try {
    await importSigningKey(env.LINEWORKS_PRIVATE_KEY);
    result.privateKey.import = "ok";
  } catch (e) {
    result.privateKey.import = "ng";
    result.privateKey.error = String(e && e.message).slice(0, 200);
  }

  // --- アクセストークン ---
  if (result.privateKey.import === "ok") {
    try {
      const { expiresIn } = await fetchAccessToken(env);
      result.accessToken.status = "ok";
      result.accessToken.expiresIn = expiresIn;
    } catch (e) {
      result.accessToken.status = "ng";
      result.accessToken.error = String(e && e.message).slice(0, 300);
    }
  } else {
    result.accessToken.status = "skipped";
  }

  // --- テスト送信 ---
  if (testUserId && result.accessToken.status === "ok") {
    const r = await postMessage(
      env,
      { userId: testUserId, channelId: null },
      { type: "text", text: "✅ Cloudflare Workers からのテスト送信です。" }
    );
    result.testSend = { ok: r.ok, status: r.status };
  }

  // --- 直近のエラー ---
  if (env.BOT_KV) {
    try {
      result.lastIssues = (await env.BOT_KV.get(ISSUE_KEY, "json")) || [];
    } catch (_) {
      result.lastIssues = [];
    }
  }

  return result;
}

