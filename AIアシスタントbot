function quickReplyAllowed(env) {
  if (quickReplyEnabled === null) {
    quickReplyEnabled = String(env.QUICK_REPLY || "").toLowerCase() === "on";
  }
  return quickReplyEnabled;
}

function messageUrl(env, target) {
  const botId = encodeURIComponent(String(env.LINEWORKS_BOT_ID || "").trim());
  const base = `${LW_API_BASE}/bots/${botId}`;
  return target.channelId
    ? `${base}/channels/${encodeURIComponent(target.channelId)}/messages`
    : `${base}/users/${encodeURIComponent(target.userId)}/messages`;
}

async function postMessage(env, target, content) {
  const doPost = (token) =>
    fetch(messageUrl(env, target), {
      method: "POST",
      headers: { Authorization: `Bearer ${token}`, "Content-Type": "application/json" },
      body: JSON.stringify({ content }),
    });

  try {
    let res = await doPost(await getAccessToken(env));

    // 401ならトークンを捨てて1度だけ再取得
    if (res.status === 401) {
      await env.BOT_KV.delete(tokenCacheKey(env)).catch(() => {});
      res = await doPost(await getAccessToken(env));
    }

    if (!res.ok) {
      // 本文にユーザーの質問は含まれないが、念のため先頭のみ記録
      const body = (await res.text()).slice(0, 200);
      await recordIssue(env, "lw_send_failed", { status: res.status, type: content.type, body });
    }
    return { ok: res.ok, status: res.status };
  } catch (e) {
    await recordIssue(env, "lw_send_exception", { message: String(e && e.message).slice(0, 200) });
    return { ok: false, status: 0 };
  }
}

function quickReply() {
  return {
    items: [
      { action: { type: "message", label: "メニュー", text: "メニュー" } },
      { action: { type: "message", label: "リセット", text: "リセット" } },
      { action: { type: "message", label: "ヘルプ", text: "ヘルプ" } },
    ],
  };
}

/** テキスト送信（長文は分割、最後の吹き出しにクイックリプライ） */
async function sendText(env, target, text, { quick = false } = {}) {
  const chunks = splitText(text, LW_TEXT_LIMIT);
  let allOk = true;

  for (let i = 0; i < chunks.length; i++) {
    const isLast = i === chunks.length - 1;
    const content = { type: "text", text: chunks[i] };
    const withQuick = quick && isLast && quickReplyAllowed(env);
    if (withQuick) content.quickReply = quickReply();

    let r = await postMessage(env, target, content);
    if (!r.ok && r.status === 400 && withQuick) {
      quickReplyEnabled = false; // 以後このisolateでは付けない
      delete content.quickReply;
      r = await postMessage(env, target, content);
    }
    if (!r.ok) allOk = false;
  }
  return allOk;
}

