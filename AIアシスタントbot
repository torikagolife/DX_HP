function json(obj, status = 200) {
  return new Response(JSON.stringify(obj, null, 2), {
    status,
    headers: { "Content-Type": "application/json; charset=utf-8" },
  });
}

export default {
  async fetch(request, env, ctx) {
    const url = new URL(request.url);

    // ---------- 診断系（GET） ----------
    if (request.method === "GET") {
      if (url.pathname === "/diag") {
        const to = url.searchParams.get("to") || "";
        return json(await buildDiag(env, to));
      }
      return json(buildHealth(env));
    }

    if (request.method !== "POST") {
      return new Response("Method Not Allowed", { status: 405 });
    }

    // ---------- Webhook（POST／パスは問わない） ----------
    const rawBody = await request.text();

    const sig = await verifySignature(env, rawBody, request.headers.get("X-WORKS-Signature"));
    if (sig === "ng") {
      // 署名が合わない＝BOT_SECRETの取り違えが多い（Client Secretと混同しやすい）
      await recordIssue(env, "invalid_signature", {
        hasHeader: !!request.headers.get("X-WORKS-Signature"),
        hint: "Bot SecretとClient Secretを取り違えていないか確認",
      });
      return new Response("Unauthorized", { status: 401 });
    }
    if (sig === "skipped") {
      logSafe("signature_check_skipped", null);
    }

    let body;
    try {
      body = JSON.parse(rawBody);
    } catch (_) {
      await recordIssue(env, "bad_json", null);
      return new Response("Bad Request", { status: 400 });
    }

    if (!isFreshEvent(body)) {
      await recordIssue(env, "stale_event_rejected", { issuedTime: body.issuedTime || null });
      return new Response("OK", { status: 200 });
    }

    // 先に200を返し、OpenAI呼び出しは裏で実行（Webhookの再送防止）
    ctx.waitUntil(
      handleEvent(env, body).catch((e) =>
        recordIssue(env, "handler_exception", {
          message: String(e && e.message).slice(0, 300),
        })
      )
    );
    return new Response("OK", { status: 200 });
  },
};
