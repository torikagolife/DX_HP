/**
 * 署名検証。
 * BOT_SECRETが未設定なら検証をスキップする（起動を優先。GAS版も検証なしで動いている）
 * 戻り値: "ok" | "skipped" | "ng"
 */
async function verifySignature(env, rawBody, signature) {
  const secret = String(env.LINEWORKS_BOT_SECRET || "").trim();
  if (!secret) return "skipped";
  if (!signature) return "ng";

  try {
    const key = await crypto.subtle.importKey(
      "raw",
      new TextEncoder().encode(secret),
      { name: "HMAC", hash: "SHA-256" },
      false,
      ["sign"]
    );
    const mac = await crypto.subtle.sign("HMAC", key, new TextEncoder().encode(rawBody));
    return safeEqual(bytesToB64(mac), signature) ? "ok" : "ng";
  } catch (e) {
    logSafe("sig_verify_exception", { name: e && e.name });
    return "ng";
  }
}

/** issuedTimeが5分以上ずれたイベントは処理しない（リプレイ緩和） */
function isFreshEvent(body) {
  if (!body.issuedTime) return true;
  const t = Date.parse(body.issuedTime);
  if (Number.isNaN(t)) return true;
  return Math.abs(Date.now() - t) < 5 * 60 * 1000;
}

// ==================================================================
// 9. KV（状態・履歴）
//    キー設計（Bot ID + スコープで分離。ユーザー間で混ざらない）
//      state:{botId}:{scope}            → { expert }
//      hist:{botId}:{scope}:{expertId}  → [{role, content}, ...]
//    scope = 1:1トーク   "u:{userId}"
//            グループ内  "c:{channelId}:u:{userId}"
// ==================================================================

function scopeOf(target) {
  return target.channelId
    ? `c:${target.channelId}:u:${target.userId}`
    : `u:${target.userId}`;
}

function stateKey(env, scope) {
  return `state:${env.LINEWORKS_BOT_ID}:${scope}`;
}

function histKey(env, scope, expertId) {
  return `hist:${env.LINEWORKS_BOT_ID}:${scope}:${expertId}`;
}

function historyTtl(env) {
  return intEnv(env.HISTORY_TTL_DAYS, DEFAULT_HISTORY_TTL_DAYS, 1, 365) * 86400;
}

function historyTurns(env) {
  return intEnv(env.HISTORY_TURNS, DEFAULT_HISTORY_TURNS, 1, 50);
}

async function loadState(env, scope) {
  try {
    const s = await env.BOT_KV.get(stateKey(env, scope), "json");
    if (s && EXPERT_BY_ID[s.expert]) return s;
  } catch (_) {
    /* 壊れていたら未選択扱い */
  }
  return { expert: null };
}

async function saveState(env, scope, state) {
  try {
    await env.BOT_KV.put(stateKey(env, scope), JSON.stringify(state), {
      expirationTtl: STATE_TTL,
    });
  } catch (e) {
    await recordIssue(env, "kv_state_put_failed", { name: e && e.name });
  }
}

async function loadHistory(env, scope, expertId) {
  try {
    const h = await env.BOT_KV.get(histKey(env, scope, expertId), "json");
    if (Array.isArray(h)) {
      return h.filter(
        (m) =>
          m &&
          (m.role === "user" || m.role === "assistant") &&
          typeof m.content === "string"
      );
    }
  } catch (_) {
    /* 壊れていたら空 */
  }
  return [];
}

async function saveHistory(env, scope, expertId, messages) {
  try {
    await env.BOT_KV.put(histKey(env, scope, expertId), JSON.stringify(messages), {
      expirationTtl: historyTtl(env),
    });
  } catch (e) {
    await recordIssue(env, "kv_hist_put_failed", { name: e && e.name });
  }
}

async function deleteHistory(env, scope, expertId) {
  await env.BOT_KV.delete(histKey(env, scope, expertId)).catch(() => {});
}

async function deleteAllHistory(env, scope) {
  await Promise.all(EXPERTS.map((e) => deleteHistory(env, scope, e.id)));
}

/** 直近N往復＋文字数上限で切り詰め。先頭は必ずuserにする */
function trimHistory(messages, turns) {
  let out = messages.slice(-turns * 2);
  let total = out.reduce((n, m) => n + m.content.length, 0);
  while (out.length > 2 && total > MAX_HISTORY_CHARS) {
    total -= out[0].content.length;
    out = out.slice(1);
  }
  while (out.length && out[0].role !== "user") out = out.slice(1);
  return out;
}

// ==================================================================
// 10. プロンプト組み立て / OpenAI
// ==================================================================

function buildSystemPrompt(env, expert) {
  const base =
    envText(env[expert.promptEnv]) ||
    `私は「${expert.name}」です。${expert.desc}の分野で長年の経験を持つ専門職として、質問に分かりやすく答えます。`;

  const parts = [base];
  if (expert.medical) parts.push(envText(env.PROMPT_COMMON_MEDICAL) || DEFAULT_COMMON_MEDICAL);
  parts.push(envText(env.PROMPT_COMMON) || DEFAULT_COMMON);
  return parts.join("\n\n");
}

async function askOpenAI(env, expert, history, userText) {
  const model = env.OPENAI_MODEL || DEFAULT_MODEL;
  // gpt-5系・oシリーズ(推論モデル)は temperature 非対応のため付けない
  const isReasoning = /^(gpt-5|o\d)/i.test(model);

  const payload = {
    model,
    messages: [
      { role: "system", content: buildSystemPrompt(env, expert) },
      ...history,
      { role: "user", content: userText },
    ],
  };
  if (isReasoning) {
    payload.max_completion_tokens = 4000; // 推論トークン込み
  } else {
    payload.max_completion_tokens = 1200;
    payload.temperature = 0.4;
  }

  let res;
  try {
    res = await fetch(OPENAI_URL, {
      method: "POST",
      headers: {
        Authorization: `Bearer ${env.OPENAI_API_KEY}`,
        "Content-Type": "application/json",
      },
      body: JSON.stringify(payload),
      signal: AbortSignal.timeout(OPENAI_TIMEOUT_MS),
    });
  } catch (e) {
    await recordIssue(env, "openai_fetch_failed", { name: e && e.name });
    return null;
  }

  if (!res.ok) {
    const body = (await res.text()).slice(0, 200); // APIキーは含まれない
    await recordIssue(env, "openai_http_error", { status: res.status, body });
    return null;
  }

  let data;
  try {
    data = await res.json();
  } catch (e) {
    await recordIssue(env, "openai_json_error", { name: e && e.name });
    return null;
  }

  const text = data?.choices?.[0]?.message?.content;
  if (typeof text !== "string" || !text.trim()) {
    await recordIssue(env, "openai_empty_response", {
      finish: data?.choices?.[0]?.finish_reason ?? null,
    });
    return null;
  }
  return text.trim();
}

