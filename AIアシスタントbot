// 3. 汎用ユーティリティ
// ==================================================================

function bytesToB64(bytes) {
  const arr = new Uint8Array(bytes);
  let bin = "";
  const CHUNK = 0x8000;
  for (let i = 0; i < arr.length; i += CHUNK) {
    bin += String.fromCharCode.apply(null, arr.subarray(i, i + CHUNK));
  }
  return btoa(bin);
}

function b64ToBytes(b64) {
  const bin = atob(b64);
  const out = new Uint8Array(bin.length);
  for (let i = 0; i < bin.length; i++) out[i] = bin.charCodeAt(i);
  return out;
}

function b64url(input) {
  const raw =
    typeof input === "string"
      ? bytesToB64(new TextEncoder().encode(input))
      : bytesToB64(input);
  return raw.replace(/\+/g, "-").replace(/\//g, "_").replace(/=+$/, "");
}

function safeEqual(a, b) {
  if (typeof a !== "string" || typeof b !== "string") return false;
  if (a.length !== b.length) return false;
  let diff = 0;
  for (let i = 0; i < a.length; i++) diff |= a.charCodeAt(i) ^ b.charCodeAt(i);
  return diff === 0;
}

/** 全角英数→半角、空白除去、小文字化（コマンド判定用） */
function normalize(text) {
  return String(text)
    .replace(/[Ａ-Ｚａ-ｚ０-９]/g, (c) => String.fromCharCode(c.charCodeAt(0) - 0xfee0))
    .replace(/[\s　]/g, "")
    .toLowerCase();
}

function intEnv(value, fallback, min, max) {
  const n = parseInt(value, 10);
  if (Number.isNaN(n)) return fallback;
  return Math.min(max, Math.max(min, n));
}

/** 環境変数のテキスト取得（"\n" 文字列を改行に戻す） */
function envText(value) {
  return typeof value === "string" ? value.replace(/\\n/g, "\n").trim() : "";
}

function byteLength(value) {
  return typeof value === "string" ? new TextEncoder().encode(value).length : 0;
}

/** 秘密情報・本文を含まない安全なログ */
function logSafe(event, detail) {
  console.log(JSON.stringify({ event, detail: detail ?? null }));
}

/**
 * エラーをKVに記録（ブラウザ運用で wrangler tail が使えないため）
 * 会話本文・ユーザーID・鍵・トークンは記録しない。
 */
async function recordIssue(env, code, detail) {
  logSafe(code, detail);
  if (!env.BOT_KV) return;
  try {
    const prev = (await env.BOT_KV.get(ISSUE_KEY, "json")) || [];
    prev.unshift({ at: new Date().toISOString(), code, detail: detail ?? null });
    await env.BOT_KV.put(ISSUE_KEY, JSON.stringify(prev.slice(0, ISSUE_KEEP)), {
      expirationTtl: ISSUE_TTL,
    });
  } catch (_) {
    /* 記録できなくても本処理は続ける */
  }
}

/** LINE WORKSの文字数上限に合わせて改行位置優先で分割 */
function splitText(text, limit) {
  const chunks = [];
  let rest = String(text);
  while (rest.length > limit) {
    let cut = rest.lastIndexOf("\n", limit);
    if (cut < limit * 0.5) cut = limit;
    chunks.push(rest.slice(0, cut).trim());
    rest = rest.slice(cut).trim();
  }
  if (rest) chunks.push(rest);
  return chunks;
}

// ==================================================================
// 4. 秘密鍵の読み込み（PKCS#8 / PKCS#1 両対応）
//    GASのcomputeRsaSha256Signatureは両方読めるが、
//    WebCryptoのimportKeyはPKCS#8しか受け付けないため変換する。
// ==================================================================

/** DERの長さフィールドを作る */
function derLength(len) {
  if (len < 0x80) return [len];
  const bytes = [];
  let x = len;
  while (x > 0) {
    bytes.unshift(x & 0xff);
    x >>= 8;
  }
  return [0x80 | bytes.length, ...bytes];
}

/**
 * PKCS#1のRSA秘密鍵を、PKCS#8の入れ物で包む。
 * PKCS#8 = SEQUENCE { INTEGER 0, SEQUENCE { OID rsaEncryption, NULL }, OCTET STRING { PKCS#1 } }
 */
function wrapPkcs1AsPkcs8(pkcs1) {
  const version = [0x02, 0x01, 0x00];
  const algId = [
    0x30, 0x0d,
    0x06, 0x09, 0x2a, 0x86, 0x48, 0x86, 0xf7, 0x0d, 0x01, 0x01, 0x01,
    0x05, 0x00,
  ];
  const octetHeader = [0x04, ...derLength(pkcs1.length)];
  const bodyLen = version.length + algId.length + octetHeader.length + pkcs1.length;
  const seqHeader = [0x30, ...derLength(bodyLen)];

  const out = new Uint8Array(seqHeader.length + bodyLen);
  let p = 0;
  const put = (arr) => { out.set(arr, p); p += arr.length; };
  put(seqHeader);
  put(version);
  put(algId);
  put(octetHeader);
  put(pkcs1);
  return out.buffer;
}

/** PEM文字列から鍵の形式を判定する（診断用） */
function detectKeyFormat(pem) {
  const s = String(pem || "").replace(/\\n/g, "\n");
  if (!s.trim()) return "empty";
  if (s.includes("BEGIN RSA PRIVATE KEY")) return "pkcs1";
  if (s.includes("BEGIN PRIVATE KEY")) return "pkcs8";
  if (s.includes("BEGIN ENCRYPTED PRIVATE KEY")) return "encrypted";
  return "headerless";
}

/** PEM本体（BASE64部分）だけを取り出してバイト列にする */
function pemBody(pem) {
  const body = String(pem)
    .replace(/\\n/g, "\n")
    .replace(/-----BEGIN [^-]+-----/g, "")
    .replace(/-----END [^-]+-----/g, "")
    .replace(/\s+/g, "");
  if (!body) throw new Error("秘密鍵が空です");
  return b64ToBytes(body);
}

/** 署名用の鍵をインポート。形式を自動判別し、PKCS#1はPKCS#8に変換する。 */
async function importSigningKey(pem) {
  const format = detectKeyFormat(pem);
  if (format === "empty") throw new Error("LINEWORKS_PRIVATE_KEY が未設定です");
  if (format === "encrypted") {
    throw new Error("パスフレーズ付きの秘密鍵は使えません。復号した鍵を登録してください");
  }

  const raw = pemBody(pem);
  const algo = { name: "RSASSA-PKCS1-v1_5", hash: "SHA-256" };

  // PKCS#1と分かっているものは変換してから読む
  if (format === "pkcs1") {
    return crypto.subtle.importKey("pkcs8", wrapPkcs1AsPkcs8(raw), algo, false, ["sign"]);
  }

  // PKCS#8として読む。失敗したらPKCS#1とみなして変換し、もう一度試す。
  try {
    return await crypto.subtle.importKey("pkcs8", raw.buffer, algo, false, ["sign"]);
  } catch (e) {
    try {
      return await crypto.subtle.importKey("pkcs8", wrapPkcs1AsPkcs8(raw), algo, false, ["sign"]);
    } catch (_) {
      throw new Error("秘密鍵を読み込めませんでした（形式: " + format + "）");
    }
  }
}

// ==================================================================
// 5. LINE WORKS 認証（JWT → アクセストークン）
// ==================================================================

function tokenCacheKey(env) {
  return `sys:lw_token:${env.LINEWORKS_CLIENT_ID}`;
}

async function createJWT(env) {
  const now = Math.floor(Date.now() / 1000);
  const header = { alg: "RS256", typ: "JWT" };
  const claims = {
    iss: String(env.LINEWORKS_CLIENT_ID || "").trim(),
    sub: String(env.LINEWORKS_SERVICE_ACCOUNT || "").trim(),
    iat: now,
    exp: now + 3600,
  };
  const signingInput = `${b64url(JSON.stringify(header))}.${b64url(JSON.stringify(claims))}`;

  const key = await importSigningKey(env.LINEWORKS_PRIVATE_KEY);
  const sig = await crypto.subtle.sign(
    "RSASSA-PKCS1-v1_5",
    key,
    new TextEncoder().encode(signingInput)
  );
  return `${signingInput}.${b64url(sig)}`;
}

/**
 * アクセストークン取得。
 * verbose=true のときは失敗理由を含む結果オブジェクトを返す（/diag 用）。
 */
async function fetchAccessToken(env) {
  const body = new URLSearchParams({
    assertion: await createJWT(env),
    grant_type: "urn:ietf:params:oauth:grant-type:jwt-bearer",
    client_id: String(env.LINEWORKS_CLIENT_ID || "").trim(),
    client_secret: String(env.LINEWORKS_CLIENT_SECRET || "").trim(),
    scope: "bot",
  });

  const res = await fetch(LW_AUTH_URL, {
    method: "POST",
    headers: { "Content-Type": "application/x-www-form-urlencoded" },
    body: body.toString(),
  });

  const text = await res.text();
  if (!res.ok) {
    // レスポンス本文にトークンは含まれない。原因表示のため先頭のみ使う。
    const reason = text.slice(0, 200);
    throw new Error(`token ${res.status}: ${reason}`);
  }

  let data;
  try {
    data = JSON.parse(text);
  } catch (_) {
    throw new Error("トークン応答がJSONではありません");
  }
  if (!data.access_token) throw new Error("access_token が含まれていません");
  return { token: data.access_token, expiresIn: Number(data.expires_in) || 86400 };
}

async function getAccessToken(env) {
  const cacheKey = tokenCacheKey(env);
  try {
    const cached = await env.BOT_KV.get(cacheKey, "json");
    if (cached && cached.exp > Math.floor(Date.now() / 1000) + 300) return cached.token;
  } catch (_) {
    /* 読み失敗は無視して再取得 */
  }

  const { token, expiresIn } = await fetchAccessToken(env);
  try {
    await env.BOT_KV.put(
      cacheKey,
      JSON.stringify({ token, exp: Math.floor(Date.now() / 1000) + expiresIn }),
      { expirationTtl: Math.max(60, expiresIn - 60) }
    );
  } catch (_) {
    /* 書き失敗は無視 */
  }
  return token;
}

