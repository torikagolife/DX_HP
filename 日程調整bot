/**
 * LINE WORKS 日程調整さんBot (GAS) ─ LINE WORKSログイン方式
 *
 * 【設計】
 *  - 回答URLは ?event=イベント名 の1本だけ。トークにそのまま転送して使える。
 *  - URLを開くと LINE WORKS の認証に飛び、戻った時点で本人が確定する。
 *    → 名前入力もBot操作も不要。
 *  - 主催者かどうかは creatorId と照合して判定。決定ボタンは主催者だけに出る。
 *    （サーバー側 decideEventDateWeb でも本人確認するのでURL直叩きも不可）
 *  - 決定通知・リマインダーは、回答者全員のBotトーク（1対1）に直接届く。
 *
 * 【作成フロー】
 *  イベント名 → 説明 → ⏱所要時間 → 日付 → 時刻（→ 追加 or 完了）
 *
 * 【フォームの表示順】
 *  ① イベント情報 → ② あなたの回答 → ③ みんなの回答 → ④ 日程ごとの集計（決定ボタン）
 *
 * 【事前準備】Developer Console の認証アプリに以下を登録
 *  - Redirect URL : このWebアプリの /exec URL（WEBAPP_URL と完全一致させる）
 *  - OAuth Scopes : user.read （Botの bot スコープはそのまま）
 *
 * 【Eventsシートの列】
 *  A:EventName B:Dates C:CreatorId D:CreatedAt E:Description
 *  F:TargetId  G:IsChannel H:DurationMin I:DecidedDate
 *
 * 【Answersシートの列】
 *  A:EventName B:UserName C:Answers D:UpdatedAt E:UserId
 */

// ===== 初期設定 =====
const PROPS = PropertiesService.getScriptProperties();
const CONFIG = {
  CLIENT_ID: PROPS.getProperty('CLIENT_ID') || "",
  CLIENT_SECRET: PROPS.getProperty('CLIENT_SECRET') || "",
  SERVICE_ACCOUNT: PROPS.getProperty('SERVICE_ACCOUNT') || "",
  PRIVATE_KEY: PROPS.getProperty('PRIVATE_KEY') || "",
  BOT_ID: PROPS.getProperty('BOT_ID') || "",
  SPREADSHEET_ID: PROPS.getProperty('SPREADSHEET_ID') || "",
  WEBAPP_URL: PROPS.getProperty('WEBAPP_URL') || "" // デプロイしたWebアプリの /exec URL
};

const EVENT_HEADER = ['EventName', 'Dates', 'CreatorId', 'CreatedAt', 'Description', 'TargetId', 'IsChannel', 'DurationMin', 'DecidedDate'];
const ANSWER_HEADER = ['EventName', 'UserName', 'Answers', 'UpdatedAt', 'UserId'];

const AUTH_URL = 'https://auth.worksmobile.com/oauth2/v2.0/authorize';
const TOKEN_URL = 'https://auth.worksmobile.com/oauth2/v2.0/token';
const OAUTH_SCOPE = 'user.read';

// ★所要時間の選択肢（ラベル：分）
const DURATION_OPTIONS = [
  { label: '15分', min: 15 },
  { label: '30分', min: 30 },
  { label: '45分', min: 45 },
  { label: '1時間', min: 60 },
  { label: '1時間30分', min: 90 },
  { label: '2時間', min: 120 },
  { label: '3時間', min: 180 },
  { label: '指定なし', min: 0 }
];

// ★時刻の選択肢（「終日」は廃止）
const TIME_OPTIONS = ["8:00", "9:00", "10:00", "11:00", "12:00", "13:00", "14:00", "15:00", "16:00", "17:00", "18:00", "19:00"];

// ===== シート =====

function getSpreadsheet() {
  if (!CONFIG.SPREADSHEET_ID) return SpreadsheetApp.getActiveSpreadsheet();
  return SpreadsheetApp.openById(CONFIG.SPREADSHEET_ID.trim());
}

function initSheets() {
  const ss = getSpreadsheet();

  let ev = ss.getSheetByName('Events');
  if (!ev) {
    ev = ss.insertSheet('Events');
    ev.appendRow(EVENT_HEADER);
  } else if (ev.getLastColumn() < EVENT_HEADER.length) {
    ev.getRange(1, 1, 1, EVENT_HEADER.length).setValues([EVENT_HEADER]);
  }

  let an = ss.getSheetByName('Answers');
  if (!an) {
    an = ss.insertSheet('Answers');
    an.appendRow(ANSWER_HEADER);
  } else if (an.getLastColumn() < ANSWER_HEADER.length) {
    an.getRange(1, 1, 1, ANSWER_HEADER.length).setValues([ANSWER_HEADER]);
  }

  if (!ss.getSheetByName('Reminders')) {
    const sheet = ss.insertSheet('Reminders');
    sheet.appendRow(['EventName', 'Kind', 'TargetId', 'IsChannel', 'Message', 'ScheduledTime']);
  }
}

function findEventRow_(eventName) {
  const data = getSpreadsheet().getSheetByName('Events').getDataRange().getValues();
  for (let i = 1; i < data.length; i++) {
    if (String(data[i][0]) === String(eventName)) {
      return {
        row: i + 1,
        eventName: String(data[i][0]),
        dates: String(data[i][1] || ""),
        creatorId: String(data[i][2] || ""),
        description: data[i][4] || "なし",
        targetId: String(data[i][5] || ""),
        isChannel: (data[i][6] === true || data[i][6] === "true"),
        durationMin: parseInt(data[i][7], 10) || 0,
        decidedDate: String(data[i][8] || "")
      };
    }
  }
  return null;
}

function isEventExists(eventName) {
  return !!findEventRow_(eventName);
}

function createEvent(eventName, dates, creatorId, description, targetId, isChannel, durationMin) {
  if (isEventExists(eventName)) {
    throw new Error("⚠️ そのイベント名は既に存在します！別の名前をご利用ください🙏");
  }
  getSpreadsheet().getSheetByName('Events')
    .appendRow([eventName, dates, creatorId, new Date(), description, targetId, isChannel, durationMin || 0, ""]);
}

function deleteEvent_(eventName) {
  const ss = getSpreadsheet();
  const ev = findEventRow_(eventName);
  if (ev) ss.getSheetByName('Events').deleteRow(ev.row);

  ['Answers', 'Reminders'].forEach(function(name) {
    const sheet = ss.getSheetByName(name);
    if (!sheet) return;
    const data = sheet.getDataRange().getValues();
    for (let i = data.length - 1; i >= 1; i--) {
      if (String(data[i][0]) === String(eventName)) sheet.deleteRow(i + 1);
    }
  });
}

// ===== 所要時間ヘルパー =====

// 「1時間30分」「90」「30分」などを分に変換。判別できなければ null
function parseDuration_(text) {
  const t = String(text || '').trim()
    .replace(/[０-９]/g, s => String.fromCharCode(s.charCodeAt(0) - 0xFEE0));

  if (['指定なし', 'なし', 'スキップ', '未定'].indexOf(t) >= 0) return 0;

  if (/^\d+$/.test(t)) {
    const n = parseInt(t, 10);
    return (n >= 0 && n <= 1440) ? n : null;
  }

  const h = t.match(/(\d+)\s*時間/);
  const m = t.match(/(\d+)\s*分/);
  if (!h && !m) return null;

  const total = (h ? parseInt(h[1], 10) * 60 : 0) + (m ? parseInt(m[1], 10) : 0);
  return (total >= 0 && total <= 1440) ? total : null;
}

function formatDuration_(min) {
  const n = parseInt(min, 10) || 0;
  if (n <= 0) return "";
  if (n < 60) return `${n}分`;
  const h = Math.floor(n / 60);
  const m = n % 60;
  return m > 0 ? `${h}時間${m}分` : `${h}時間`;
}

// 決定日時の表示（所要時間があれば終了予定も付ける）
function buildDecidedLine_(decidedDate, durationMin) {
  const label = formatDuration_(durationMin);
  if (!label) return decidedDate;

  const start = parseDateString(decidedDate);
  if (!start) return `${decidedDate}（所要 ${label}）`;

  const end = new Date(start.getTime() + (parseInt(durationMin, 10) * 60 * 1000));
  const hh = ('0' + end.getHours()).slice(-2);
  const mm = ('0' + end.getMinutes()).slice(-2);
  return `${decidedDate} 〜 ${hh}:${mm}（所要 ${label}）`;
}

// 回答の保存（userIdで同一人物を判定。旧データは名前で照合）
function recordAnswer_(eventName, userId, userName, answers) {
  const ev = findEventRow_(eventName);
  if (!ev) throw new Error(`イベント「${eventName}」が見つかりません`);

  const expectedCount = ev.dates.split(',').length;
  if (String(answers).split(',').length !== expectedCount) {
    throw new Error(`回答の数が候補日時と合いません（候補は ${expectedCount} 個）`);
  }

  const sheet = getSpreadsheet().getSheetByName('Answers');
  const data = sheet.getDataRange().getValues();
  let rowIndex = -1;

  for (let i = 1; i < data.length; i++) {
    if (String(data[i][0]) !== String(eventName)) continue;
    const rowUserId = String(data[i][4] || "");
    if (rowUserId) {
      if (rowUserId === String(userId)) { rowIndex = i + 1; break; }
    } else if (String(data[i][1]) === String(userName)) {
      rowIndex = i + 1; break; // 旧データ（UserIdなし）は名前で拾う
    }
  }

  if (rowIndex > -1) {
    sheet.getRange(rowIndex, 1, 1, 5).setValues([[eventName, userName, answers, new Date(), userId]]);
    return 'updated';
  }
  sheet.appendRow([eventName, userName, answers, new Date(), userId]);
  return 'created';
}

function getAnswersOf_(eventName, dates) {
  const data = getSpreadsheet().getSheetByName('Answers').getDataRange().getValues();
  const allAnswers = [];
  const counts = dates.map(() => ({'〇': 0, '△': 0, '×': 0}));

  for (let i = 1; i < data.length; i++) {
    if (String(data[i][0]) !== String(eventName)) continue;
    const marks = String(data[i][2]).split(',').map(function(m) { return m.trim(); });
    allAnswers.push({ name: String(data[i][1]), marks: marks, userId: String(data[i][4] || "") });
    for (let j = 0; j < marks.length; j++) {
      if (counts[j] && counts[j][marks[j]] !== undefined) counts[j][marks[j]]++;
    }
  }
  return { allAnswers: allAnswers, counts: counts };
}

function getSummary(eventName) {
  const ev = findEventRow_(eventName);
  if (!ev) throw new Error(`😢 イベント「${eventName}」が見つかりません。`);

  const dates = ev.dates.split(',');
  const res = getAnswersOf_(eventName, dates);
  const durLabel = formatDuration_(ev.durationMin);

  let t = `📊 【${eventName}】の回答状況\n\n`;
  if (ev.description && ev.description !== "なし") t += `📝 ◆ 説明\n${ev.description}\n\n`;
  if (durLabel) t += `⏱ ◆ 予想所要時間\n${durLabel}\n\n`;
  if (ev.decidedDate) t += `🎉 ◆ 決定済み\n${buildDecidedLine_(ev.decidedDate, ev.durationMin)}\n\n`;
  t += `👥 ◆ 回答者（${res.allAnswers.length}人）\n`;
  t += res.allAnswers.length > 0
    ? res.allAnswers.map(function(a) { return `${a.name}: ${a.marks.join(' ')}`; }).join('\n')
    : "まだ回答がありません💦";
  t += `\n\n🎯 ◆ 日程ごとの集計\n`;
  for (let i = 0; i < dates.length; i++) {
    t += `${dates[i]}\n 〇${res.counts[i]['〇']} △${res.counts[i]['△']} ×${res.counts[i]['×']}\n`;
  }
  return t;
}

// ===== 共有メッセージ =====

function buildAnswerUrl_(eventName) {
  return `${CONFIG.WEBAPP_URL}?event=${encodeURIComponent(eventName)}`;
}

// ★そのまま転送して使えるプレーンテキスト
function buildShareMessage_(eventName, description, dates, durationMin) {
  const durLabel = formatDuration_(durationMin);
  let t = `📅 【${eventName}】日程調整のお願い\n\n`;
  if (description && description !== "なし") t += `📝 ${description}\n`;
  if (durLabel) t += `⏱ 予想所要時間：${durLabel}\n`;
  t += `\n◆ 候補日時\n${dates.join('\n')}\n\n`;
  t += `▼ 下のURLを開いて出欠（〇△×）をご回答ください\n`;
  t += buildAnswerUrl_(eventName);
  t += `\n\n※LINE WORKSのログイン確認が出たら承認してください。お名前の入力は不要です。`;
  return t;
}

// ===== LINE WORKS API（Bot用 / Service Account認証）=====

function repairPrivateKey(key) {
  if (!key) return "";
  const header = "-----BEGIN PRIVATE KEY-----";
  const footer = "-----END PRIVATE KEY-----";
  let normalizedKey = key.replace(/\\n/g, '\n').replace(/\\r/g, '');
  if (normalizedKey.indexOf(header) !== -1 && normalizedKey.indexOf(footer) !== -1) {
    let body = normalizedKey.substring(normalizedKey.indexOf(header) + header.length, normalizedKey.indexOf(footer));
    body = body.replace(/\s+/g, '');
    let formattedBody = body.match(/.{1,64}/g).join('\n');
    return header + '\n' + formattedBody + '\n' + footer;
  }
  return key;
}

function getAccessToken() {
  const cache = CacheService.getScriptCache();
  const token = cache.get('LINEWORKS_TOKEN_V3');
  if (token) return token;

  const privateKey = repairPrivateKey(CONFIG.PRIVATE_KEY);
  const now = Math.floor(Date.now() / 1000);
  const header = { alg: "RS256", typ: "JWT" };
  const payload = {
    iss: CONFIG.CLIENT_ID.trim(),
    sub: CONFIG.SERVICE_ACCOUNT.trim(),
    iat: now,
    exp: now + 3600
  };

  const encodedHeader = Utilities.base64EncodeWebSafe(JSON.stringify(header));
  const encodedPayload = Utilities.base64EncodeWebSafe(JSON.stringify(payload));
  const signingInput = encodedHeader + "." + encodedPayload;
  const signatureBytes = Utilities.computeRsaSha256Signature(signingInput, privateKey);
  const jwt = signingInput + "." + Utilities.base64EncodeWebSafe(signatureBytes);

  const response = UrlFetchApp.fetch(TOKEN_URL, {
    method: "post",
    payload: {
      assertion: jwt,
      grant_type: "urn:ietf:params:oauth:grant-type:jwt-bearer",
      client_id: CONFIG.CLIENT_ID.trim(),
      client_secret: CONFIG.CLIENT_SECRET.trim(),
      scope: "bot,user.read"
    },
    muteHttpExceptions: true
  });

  const text = response.getContentText();
  if (!text.startsWith("{")) throw new Error("Token取得失敗: " + text);
  const json = JSON.parse(text);
  if (!json.access_token) throw new Error(text);

  cache.put('LINEWORKS_TOKEN_V3', json.access_token, 3000);
  return json.access_token;
}

function getUserName(userId) {
  if (!userId) return "メンバー";
  const response = UrlFetchApp.fetch("https://www.worksapis.com/v1.0/users/" + encodeURIComponent(userId), {
    method: "get",
    headers: { Authorization: "Bearer " + getAccessToken() },
    muteHttpExceptions: true
  });
  if (response.getResponseCode() !== 200) return "メンバー";
  return extractName_(JSON.parse(response.getContentText()), userId);
}

function extractName_(json, fallback) {
  if (json.userName) {
    const full = ((json.userName.lastName || "") + " " + (json.userName.firstName || "")).trim();
    if (full) return full;
  }
  const email = json.email || json.externalEmail || json.userEmail || "";
  if (email) return email.split('@')[0];
  return fallback || "メンバー";
}

function sendWorksMessage(targetId, isChannel, contentObject) {
  const token = getAccessToken();
  const url = isChannel
    ? `https://www.worksapis.com/v1.0/bots/${CONFIG.BOT_ID.trim()}/channels/${targetId}/messages`
    : `https://www.worksapis.com/v1.0/bots/${CONFIG.BOT_ID.trim()}/users/${targetId}/messages`;

  const response = UrlFetchApp.fetch(url, {
    method: 'post',
    headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
    payload: JSON.stringify({ content: contentObject }),
    muteHttpExceptions: true
  });
  const code = response.getResponseCode();
  if (code !== 200 && code !== 201) {
    console.error("Message送信失敗(" + code + "): " + response.getContentText());
    return false;
  }
  return true;
}

function sendText_(targetId, isChannel, text) {
  return sendWorksMessage(targetId, isChannel, { type: "text", text: text });
}

// ===== User Account認証（OAuth 2.0）=====

// 認可URLを作る。stateにイベント名を紐づけてキャッシュへ。
function buildAuthorizeUrl_(eventName) {
  const state = Utilities.getUuid().replace(/-/g, '');
  CacheService.getScriptCache().put('oauth_state_' + state, eventName, 600); // 10分

  const params = [
    'client_id=' + encodeURIComponent(CONFIG.CLIENT_ID.trim()),
    'redirect_uri=' + encodeURIComponent(CONFIG.WEBAPP_URL),
    'scope=' + encodeURIComponent(OAUTH_SCOPE),
    'response_type=code',
    'state=' + encodeURIComponent(state)
  ];
  return AUTH_URL + '?' + params.join('&');
}

// 認可コード → アクセストークン
function exchangeCodeForToken_(code) {
  const response = UrlFetchApp.fetch(TOKEN_URL, {
    method: 'post',
    payload: {
      grant_type: 'authorization_code',
      code: code,
      client_id: CONFIG.CLIENT_ID.trim(),
      client_secret: CONFIG.CLIENT_SECRET.trim(),
      redirect_uri: CONFIG.WEBAPP_URL
    },
    muteHttpExceptions: true
  });
  const text = response.getContentText();
  if (!text.startsWith('{')) throw new Error('トークン取得に失敗しました: ' + text);
  const json = JSON.parse(text);
  if (!json.access_token) throw new Error('トークン取得に失敗しました: ' + text);
  return json.access_token;
}

// アクセストークンで本人情報を取得
function fetchMe_(accessToken) {
  const response = UrlFetchApp.fetch('https://www.worksapis.com/v1.0/users/me', {
    method: 'get',
    headers: { Authorization: 'Bearer ' + accessToken },
    muteHttpExceptions: true
  });
  if (response.getResponseCode() !== 200) {
    throw new Error('メンバー情報の取得に失敗しました: ' + response.getContentText());
  }
  const json = JSON.parse(response.getContentText());
  const userId = json.userId || json.id || "";
  if (!userId) throw new Error('メンバーIDが取得できませんでした');
  return { userId: String(userId), userName: extractName_(json, String(userId)) };
}

// ログインセッション（本人情報のみキャッシュ。アクセストークンは保持しない）
function createSession_(me) {
  const sid = Utilities.getUuid().replace(/-/g, '');
  CacheService.getScriptCache().put('sess_' + sid, JSON.stringify(me), 21600); // 6時間
  return sid;
}

function readSession_(sid) {
  if (!sid) return null;
  const raw = CacheService.getScriptCache().get('sess_' + sid);
  if (!raw) return null;
  try { return JSON.parse(raw); } catch (err) { return null; }
}

// クライアントから呼ばれる入口。ログイン済みならフォームデータ、未ログインなら認可URLを返す。
function bootstrap(eventName, sid) {
  const ev = findEventRow_(eventName);
  if (!ev || !ev.dates) return { error: "⚠️ イベントが見つかりません。削除された可能性があります。" };

  const dates = ev.dates.split(',');
  const base = {
    eventName: ev.eventName,
    creatorName: getUserName(ev.creatorId),
    description: ev.description,
    durationLabel: formatDuration_(ev.durationMin),
    decidedDate: ev.decidedDate,
    decidedLine: ev.decidedDate ? buildDecidedLine_(ev.decidedDate, ev.durationMin) : "",
    dates: dates
  };

  const me = readSession_(sid);
  if (!me) {
    if (!CONFIG.WEBAPP_URL) return { error: "🚨 WEBAPP_URLが未設定です。管理者にご連絡ください。" };
    base.needLogin = true;
    base.authUrl = buildAuthorizeUrl_(eventName);
    return base;
  }

  const res = getAnswersOf_(eventName, dates);
  let myAnswers = null;
  res.allAnswers.forEach(function(a) {
    if (a.userId === me.userId || (!a.userId && a.name === me.userName)) myAnswers = a.marks;
  });

  base.needLogin = false;
  base.me = me;
  base.isCreator = (String(me.userId) === String(ev.creatorId));
  base.allAnswers = res.allAnswers.map(function(a) { return { name: a.name, marks: a.marks }; });
  base.counts = res.counts;
  base.myAnswers = myAnswers;
  return base;
}

// ===== Web App =====

function doGet(e) {
  const p = (e && e.parameter) ? e.parameter : {};

  // --- OAuthのコールバック ---
  if (p.code && p.state) {
    const eventName = CacheService.getScriptCache().get('oauth_state_' + p.state);
    if (!eventName) {
      return renderShell_("", "", "⚠️ ログインの有効期限が切れました。お手数ですが、共有されたURLをもう一度開いてください。");
    }
    try {
      const me = fetchMe_(exchangeCodeForToken_(p.code));
      return renderShell_(eventName, createSession_(me), "");
    } catch (err) {
      return renderShell_(eventName, "", "🚨 ログインに失敗しました。\n" + err.message);
    }
  }

  if (p.error) {
    return renderShell_(p.event || "", "", "🚨 ログインがキャンセルされました。もう一度お試しください。");
  }

  if (!p.event) {
    return renderShell_("", "", "🚨 URLが正しくありません。共有されたリンクから開き直してください。");
  }

  return renderShell_(p.event, p.sid || "", "");
}

