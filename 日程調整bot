function parseDateString(dateStr) {
  // 例: "7/27(月) 15:00", "12/10(木)"
  const now = new Date();
  const currentYear = now.getFullYear();

  const dateMatch = String(dateStr).match(/(\d{1,2})\/(\d{1,2})/);
  if (!dateMatch) return null;

  const month = parseInt(dateMatch[1], 10) - 1; // JSの月は0ベース
  const day = parseInt(dateMatch[2], 10);

  let targetDate = new Date(currentYear, month, day);
  if (targetDate.getTime() < now.getTime() - (30 * 24 * 60 * 60 * 1000)) {
    targetDate.setFullYear(currentYear + 1);
  }

  const timeMatch = String(dateStr).match(/(\d{1,2}):(\d{2})/);
  if (timeMatch) {
    targetDate.setHours(parseInt(timeMatch[1], 10));
    targetDate.setMinutes(parseInt(timeMatch[2], 10));
  } else {
    targetDate.setHours(0, 0, 0, 0);
  }
  return targetDate;
}

function checkAndSendReminders() {
  const sheet = getSpreadsheet().getSheetByName('Reminders');
  if (!sheet) return;

  const data = sheet.getDataRange().getValues();
  if (data.length <= 1) return;

  const now = new Date().getTime();
  const rowsToDelete = [];

  // 下から上へ（行削除時のインデックスずれ防止）
  for (let i = data.length - 1; i >= 1; i--) {
    const scheduledTime = parseInt(data[i][5], 10);
    if (!scheduledTime || now < scheduledTime) continue;
    const targetId = data[i][2];
    const isChannel = (data[i][3] === "true" || data[i][3] === true);
    const message = data[i][4];
    if (targetId && message) sendText_(targetId, isChannel, message);
    rowsToDelete.push(i + 1);
  }

  for (const rowNum of rowsToDelete) sheet.deleteRow(rowNum);
}

function setupReminderTrigger() {
  const triggers = ScriptApp.getProjectTriggers();
  for (let i = 0; i < triggers.length; i++) {
    if (triggers[i].getHandlerFunction() === 'checkAndSendReminders') return;
  }
  ScriptApp.newTrigger('checkAndSendReminders').timeBased().everyMinutes(1).create();
}

