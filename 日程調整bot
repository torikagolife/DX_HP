    // ---- ログイン済み：本体 ----
    // 表示順：① イベント情報 → ② あなたの回答 → ③ みんなの回答 → ④ 日程ごとの集計
    function renderForm(data) {
      const total = data.allAnswers.length;
      myAnswers = data.dates.map(function(d, i) {
