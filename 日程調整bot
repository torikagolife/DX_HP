        if (data.dates.length > 2) h += '<div class="muted small hint">← 横にスクロールできます →</div>';
      } else {
        h += '<p class="muted" style="margin:0;">まだ回答がありません💦</p>';
      }
      h += '</div>';

      // ======== ④ 日程ごとの集計（★決定ボタンは主催者のみ描画）========
      h += '<div class="card"><div class="sec-title">📊 日程ごとの集計（' + total + '人回答）</div>';
      data.dates.forEach(function(d, i) {
