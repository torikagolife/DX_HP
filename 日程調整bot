    function render(data) {
      if (data.error) { fatal(data.error); return; }
      formData = data;
      if (data.needLogin) { renderLogin(data); return; }
      renderForm(data);
    }

    // ---- 未ログイン：イベント内容＋ログインボタン ----
    function renderLogin(data) {
      let h = eventInfoCard(data);

      h += '<div class="card"><div class="login-box">';
      h += '<p class="lead">候補日時</p>';
      h += '<div class="date-list">';
      data.dates.forEach(function(d) { h += '<div>・' + esc(d) + '</div>'; });
      h += '</div>';
      h += '<p class="muted small">回答にはLINE WORKSの確認が必要です。<br>お名前の入力は不要です。</p>';
      h += '<button type="button" id="loginBtn" class="login-btn" style="margin-top:14px;">🔐 LINE WORKSで続ける</button>';
      h += '</div></div>';
      document.getElementById('app').innerHTML = h;

      // ★GASはiframe内で動くため、window.top を書き換えて外に出る（ユーザー操作が必須）
