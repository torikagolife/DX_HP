    } else {
      sid = INITIAL_SID || getStoredSid();
      if (INITIAL_SID) setStoredSid(INITIAL_SID);
      google.script.run
        .withSuccessHandler(render)
        .withFailureHandler(function(err) { fatal('🚨 読み込みに失敗しました\\n' + (err && err.message ? err.message : err)); })
        .bootstrap(EVENT_NAME, sid);
