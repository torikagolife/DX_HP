        h += '<div class="sum-item' + best + '">';
        h += '<div class="sum-date">' + esc(d) + '</div>';
        h += '<div class="sum-counts"><span class="mark-o">〇 ' + c['〇'] + '</span><span class="mark-d">△ ' + c['△'] + '</span><span class="mark-x">× ' + c['×'] + '</span></div>';
        h += '<div class="bar"><div style="width:' + pct + '%"></div></div>';
        if (data.isCreator) h += '<button type="button" class="decide-btn" data-idx="' + i + '">✅ この日程で決定</button>';
        h += '</div>';
      });
      if (!data.isCreator) h += '<p class="muted small" style="margin:12px 0 0;">※日程の決定は主催者が行います。</p>';
      h += '</div>';

      h += '<div class="submit-bar"><button type="button" id="submitBtn" class="submit-btn">🚀 この内容で回答する</button></div>';

      document.getElementById('app').innerHTML = h;
    }

    function setMark(idx, mark) {
      if (MARKS.indexOf(mark) < 0) return;
      myAnswers[idx] = mark;
      document.querySelectorAll('.seg-btn[data-idx="' + idx + '"]').forEach(function(b) {
        if (b.dataset.mark === mark) b.classList.add('sel'); else b.classList.remove('sel');
