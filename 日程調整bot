  html += `<script>
    const EVENT_NAME = ${JSON.stringify(eventName).replace(/</g, '\\u003c')};
    const INITIAL_SID = ${JSON.stringify(sid).replace(/</g, '\\u003c')};
    const FATAL = ${JSON.stringify(fatalMessage).replace(/</g, '\\u003c')};
    const MARKS = ['〇', '△', '×'];
    const SID_KEY = 'nittei_sid';

    let sid = "";
    let formData = null;
    let myAnswers = [];
    let selectedDateForDecision = "";
    let reminderMin = 0;

    function esc(s) {
      return String(s == null ? '' : s)
        .replace(/&/g, '&amp;').replace(/</g, '&lt;')
        .replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }
    function getStoredSid() { try { return localStorage.getItem(SID_KEY) || ''; } catch (e) { return ''; } }
    function setStoredSid(v) { try { localStorage.setItem(SID_KEY, v); } catch (e) {} }

    function showToast(msg, ms) {
      const t = document.getElementById('toast');
