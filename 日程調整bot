// ===== クライアントから呼ばれるサーバー処理 =====

function submitAnswerWeb(eventName, sid, answersStr) {
  const me = readSession_(sid);
  if (!me) throw new Error("ログインの有効期限が切れました。画面を再読み込みしてください");

  const result = recordAnswer_(eventName, me.userId, me.userName, answersStr);

  // 主催者に通知
  const ev = findEventRow_(eventName);
  if (ev && ev.targetId && String(ev.creatorId) !== String(me.userId)) {
    const res = getAnswersOf_(eventName, ev.dates.split(','));
    const verb = (result === 'updated') ? '回答を修正' : '回答';
    sendText_(ev.targetId, ev.isChannel,
      `📩 【${eventName}】\n${me.userName}さんが${verb}しました（計${res.allAnswers.length}人）\n\n${String(answersStr).split(',').join(' ')}\n\n「確認 ${eventName}」で集計を見られます📊`);
  }
  return result;
}

function decideEventDateWeb(eventName, sid, decidedDate, reminderMinutes) {
  const me = readSession_(sid);
  if (!me) throw new Error("ログインの有効期限が切れました。画面を再読み込みしてください");

  const ss = getSpreadsheet();
  const ev = findEventRow_(eventName);
  if (!ev) throw new Error("イベントが見つかりませんでした");

  // ★主催者チェック（サーバー側で本人確認。URL直叩きでも通らない）
  if (String(me.userId) !== String(ev.creatorId)) {
    throw new Error("日程を決定できるのは主催者だけです🙏");
  }

  ss.getSheetByName('Events').getRange(ev.row, 9).setValue(decidedDate);

  // 宛先＝回答者全員＋主催者（重複除去）
  const res = getAnswersOf_(eventName, ev.dates.split(','));
  const targets = {};
  res.allAnswers.forEach(function(a) { if (a.userId) targets[a.userId] = true; });
  if (ev.creatorId) targets[ev.creatorId] = true;
  const targetIds = Object.keys(targets);

  // ★所要時間があれば終了予定も出す
  let msg = `🎉 【${eventName}】の日程が決定しました！\n\n📅 ${buildDecidedLine_(decidedDate, ev.durationMin)}\n`;
  if (ev.description && ev.description !== "なし") msg += `📝 ${ev.description}\n`;
  msg += `\nご参加をお願いします🙇‍♂️`;
  if (reminderMinutes && reminderMinutes > 0) {
    msg += `\n\n🔔 開始 ${reminderMinutes} 分前にリマインドをお送りします。`;
  }

  let sent = 0;
  targetIds.forEach(function(uid) { if (sendText_(uid, false, msg)) sent++; });

  // リマインダー登録（1人1行）
  if (reminderMinutes && reminderMinutes > 0) {
    const targetDateTime = parseDateString(decidedDate);
    if (targetDateTime) {
      const triggerTime = new Date(targetDateTime.getTime() - (reminderMinutes * 60 * 1000));
      const durLabel = formatDuration_(ev.durationMin);
      let reminderMsg = `🔔 まもなく【${eventName}】が始まります！\n\n📅 ${buildDecidedLine_(decidedDate, ev.durationMin)}`;
      if (ev.description && ev.description !== "なし") reminderMsg += `\n📝 ${ev.description}`;
      const sheet = ss.getSheetByName('Reminders');
      targetIds.forEach(function(uid) {
        sheet.appendRow([eventName, 'POLLING', uid, 'false', reminderMsg, triggerTime.getTime()]);
      });
    }
  }

  return { sent: sent, total: targetIds.length };
}

