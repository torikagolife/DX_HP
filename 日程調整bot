    function closeModal() {
      document.getElementById('reminderModal').classList.remove('show');
      document.body.style.overflow = '';
      selectedDateForDecision = "";
    }
    function executeDecide() {
      if (!selectedDateForDecision) return;
      const targetDateStr = selectedDateForDecision;
      const min = reminderMin;
      closeModal();
      showToast('⏳ 通知を送信しています...', 15000);
      document.querySelectorAll('.decide-btn').forEach(function(b) { b.disabled = true; });

