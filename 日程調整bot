// ===== Webhook =====

const DRAFT_KEYS = ['event_name_', 'event_desc_', 'event_dur_', 'event_dates_', 'temp_date_'];

function clearDraft_(cache, userId) {
  DRAFT_KEYS.forEach(function(k) { cache.remove(k + userId); });
  cache.remove('state_' + userId);
}

function doPost(e) {
  try {
    if (!e || !e.postData || !e.postData.contents) return ContentService.createTextOutput("200 OK");

    const json = JSON.parse(e.postData.contents);
    const userId = (json.source && (json.source.accountId || json.source.userId)) || "";
    const channelId = json.source && json.source.channelId;
    const targetId = channelId ? channelId : userId;
    const isChannel = !!channelId;
    if (!userId) return ContentService.createTextOutput("200 OK");

    const cache = CacheService.getScriptCache();
    const stateKey = 'state_' + userId;
    const currentState = cache.get(stateKey);

    initSheets();

    if (json.type !== 'message') return ContentService.createTextOutput("200 OK");
    const text = (json.content && json.content.text) ? json.content.text.trim() : "";
    if (!text) return ContentService.createTextOutput("200 OK");

    if (text === 'キャンセル') {
      clearDraft_(cache, userId);
      sendText_(targetId, isChannel, "❌ イベント作成をキャンセルしました。");
      return ContentService.createTextOutput("200 OK");
    }

    // 【STEP 1】イベント名
    if (currentState === 'WAIT_EVENT_NAME') {
      if (isEventExists(text)) {
        sendText_(targetId, isChannel, `⚠️ イベント名「${text}」は既に存在します！\n別の名前を入力してください🙏\n（やめる場合は「キャンセル」）`);
        return ContentService.createTextOutput("200 OK");
      }
      cache.put('event_name_' + userId, text, 3600);
      cache.put(stateKey, 'WAIT_EVENT_DESC', 3600);
      sendText_(targetId, isChannel, `✅ イベント名を「${text}」に設定しました！\n\n次に【📝 説明】を入力してください。\n（特にない場合は「なし」）`);
      return ContentService.createTextOutput("200 OK");
    }

    // 【STEP 2】説明 → ★所要時間へ
    if (currentState === 'WAIT_EVENT_DESC') {
      cache.put('event_desc_' + userId, text, 3600);
      cache.put(stateKey, 'WAIT_EVENT_DURATION', 3600);
      sendDurationCarousel(targetId, isChannel);
      return ContentService.createTextOutput("200 OK");
    }

    // 【STEP 3】★予想所要時間
    if (currentState === 'WAIT_EVENT_DURATION') {
      const dur = parseDuration_(text);
      if (dur === null) {
        sendText_(targetId, isChannel, "⚠️ 所要時間が読み取れませんでした💦\nボタンから選ぶか、「45」「1時間30分」のように入力してください🙏");
        return ContentService.createTextOutput("200 OK");
      }
      cache.put('event_dur_' + userId, String(dur), 3600);
      cache.put('event_dates_' + userId, JSON.stringify([]), 3600);
      cache.put(stateKey, 'WAIT_EVENT_DATES', 3600);

      const label = formatDuration_(dur);
      sendText_(targetId, isChannel, label
        ? `⏱ 予想所要時間を「${label}」に設定しました！\n\n続いて候補日時を選んでください👇`
        : `⏱ 予想所要時間は「指定なし」にしました。\n\n続いて候補日時を選んでください👇`);
      sendDateCarousel(targetId, isChannel);
      return ContentService.createTextOutput("200 OK");
    }

    // 【STEP 4】日付
    if (currentState === 'WAIT_EVENT_DATES') {
      if (text === 'さらに追加') {
        sendDateCarousel(targetId, isChannel);
        return ContentService.createTextOutput("200 OK");
      }
      if (text === '完了') {
        const dates = JSON.parse(cache.get('event_dates_' + userId) || "[]");
        if (dates.length === 0) {
          sendText_(targetId, isChannel, "⚠️ 候補日時が1つもありません💦 最低1つは選択してください🙏");
          return ContentService.createTextOutput("200 OK");
        }
        const eventName = cache.get('event_name_' + userId);
        const eventDesc = cache.get('event_desc_' + userId);
        const eventDur = parseInt(cache.get('event_dur_' + userId), 10) || 0;

        createEvent(eventName, dates.join(','), userId, eventDesc, targetId, isChannel, eventDur);
        clearDraft_(cache, userId);

        if (!CONFIG.WEBAPP_URL) {
          sendText_(targetId, isChannel, "🚨 WEBAPP_URLが未設定です。スクリプトプロパティを確認してください。");
          return ContentService.createTextOutput("200 OK");
        }
        sendText_(targetId, isChannel, `✨ イベント「${eventName}」を作成しました！\n\n📤 次のメッセージをそのままトークに転送してください👇`);
        sendText_(targetId, isChannel, buildShareMessage_(eventName, eventDesc, dates, eventDur));
        return ContentService.createTextOutput("200 OK");
      }

      cache.put('temp_date_' + userId, text, 3600);
      cache.put(stateKey, 'WAIT_EVENT_TIME', 3600);
      sendTimeCarousel(targetId, isChannel, text);
      return ContentService.createTextOutput("200 OK");
    }

    // 【STEP 5】時間
    if (currentState === 'WAIT_EVENT_TIME') {
      const tempDate = cache.get('temp_date_' + userId);
      if (tempDate) {
        let timeStr = text;
        const normalized = text.replace(/[０-９]/g, s => String.fromCharCode(s.charCodeAt(0) - 0xFEE0));
        if (/^\d{4}$/.test(normalized)) {
          timeStr = normalized.substring(0, 2) + ":" + normalized.substring(2, 4);
        }
        addDateAndShowMenu(`${tempDate} ${timeStr}`, userId, targetId, isChannel);
      }
      return ContentService.createTextOutput("200 OK");
    }

    // ===== コマンド =====
    const args = text.split(/[\s　]+/); // 全角・半角スペース両対応
    const command = args[0];
    const restName = args.slice(1).join(' ');

    if (['いべんと', 'イベント', '作成', 'つくる'].includes(command) && args.length === 1) {
      cache.put(stateKey, 'WAIT_EVENT_NAME', 3600);
      sendText_(targetId, isChannel, "🎉 イベント作成を開始します！\nまずは【イベント名】を入力してください。\n（やめる場合は「キャンセル」）");
      return ContentService.createTextOutput("200 OK");
    }

    if (['URL', 'url', '回答URL', '共有'].includes(command) && restName) {
      const ev = findEventRow_(restName);
      if (!ev) {
        sendText_(targetId, isChannel, `😢 イベント「${restName}」が見つかりません。\n「一覧」で確認できます。`);
        return ContentService.createTextOutput("200 OK");
      }
      if (!CONFIG.WEBAPP_URL) {
        sendText_(targetId, isChannel, "🚨 WEBAPP_URLが未設定です。");
        return ContentService.createTextOutput("200 OK");
      }
      sendText_(targetId, isChannel, "📤 下のメッセージをそのままトークに転送してください👇");
      sendText_(targetId, isChannel, buildShareMessage_(ev.eventName, ev.description, ev.dates.split(','), ev.durationMin));
      return ContentService.createTextOutput("200 OK");
    }

    if (['一覧', 'いちらん', 'list'].includes(command.toLowerCase())) {
      const data = getSpreadsheet().getSheetByName('Events').getDataRange().getValues();
      const mine = [];
      for (let i = 1; i < data.length; i++) {
        if (String(data[i][2]) === String(userId)) {
          mine.push({ name: String(data[i][0]), decided: String(data[i][8] || "") });
        }
      }
      if (mine.length === 0) {
        sendText_(targetId, isChannel, "📭 作成したイベントはまだありません。\n「イベント」と送信して作成できます✨");
        return ContentService.createTextOutput("200 OK");
      }
      let t = `📋 あなたが作成したイベント（${mine.length}件）\n\n`;
      t += mine.map(function(m) { return m.decided ? `・${m.name}（決定：${m.decided}）` : `・${m.name}`; }).join('\n');
      t += `\n\n「確認 イベント名」で集計、「URL イベント名」で転送用メッセージを再発行できます💡`;
      sendText_(targetId, isChannel, t);
      return ContentService.createTextOutput("200 OK");
    }

    if (command === '確認' && restName) {
      sendText_(targetId, isChannel, getSummary(restName));
      return ContentService.createTextOutput("200 OK");
    }

    if (command === '削除' && restName) {
      const ev = findEventRow_(restName);
      if (!ev) {
        sendText_(targetId, isChannel, `😢 イベント「${restName}」が見つかりません。`);
        return ContentService.createTextOutput("200 OK");
      }
      if (String(ev.creatorId) !== String(userId)) {
        sendText_(targetId, isChannel, `⚠️ 「${restName}」を削除できるのは主催者だけです🙏`);
        return ContentService.createTextOutput("200 OK");
      }
      deleteEvent_(restName);
      sendText_(targetId, isChannel, `🗑️ イベント「${restName}」と回答をすべて削除しました。`);
      return ContentService.createTextOutput("200 OK");
    }

    if (['へるぷ', 'ヘルプ', 'help'].includes(command.toLowerCase())) {
      sendText_(targetId, isChannel, `🤖 【日程調整さんBot の使い方】

◆ 📅 作る
「イベント」と送信 → 名前 → 説明 → 予想所要時間 → 候補日時 の順に設定。
作成すると、そのまま転送できるメッセージが届きます。

◆ 📤 集める
届いたメッセージをトークに転送するだけ。
受け取った人はURLを開いて〇△×をタップするだけです。
（LINE WORKSの確認が一度入りますが、名前の入力は不要です）

◆ 📊 見る・決める
「確認 イベント名」で集計をトークに表示。
日程の決定ボタンは、主催者がURLを開いたときだけ表示されます。
決定すると、回答者全員のBotトークに通知が届きます。

◆ 🔁 その他
・一覧 … 自分が作ったイベント一覧
・URL イベント名 … 転送用メッセージを再発行
・削除 イベント名 … イベントと回答を削除
・キャンセル … 作成の中断`);
      return ContentService.createTextOutput("200 OK");
    }

    sendText_(targetId, isChannel, `🤖 コマンドがわかりません💦\n「ヘルプ」と送信すると使い方が見られます💡`);
    return ContentService.createTextOutput("200 OK");

  } catch (error) {
    console.error("doPost Error: " + error.message);
    if (e && e.postData) {
      try {
        const json = JSON.parse(e.postData.contents);
        const tId = (json.source && json.source.channelId) || (json.source && (json.source.accountId || json.source.userId));
        const isCh = !!(json.source && json.source.channelId);
        if (tId) sendText_(tId, isCh, `🚨 エラーが発生しました: ${error.message}`);
      } catch (e2) {
        console.error("error notify failed: " + e2.message);
      }
    }
  }

  return ContentService.createTextOutput("200 OK");
}
