        return MARKS.indexOf(v) >= 0 ? v : '〇';
      });

      let maxO = 0;
      data.counts.forEach(function(c) { if (c['〇'] > maxO) maxO = c['〇']; });

      // ======== ① イベント情報 ========
      let h = eventInfoCard(data);

      // ======== ② あなたの回答 ========
      h += '<div class="card"><div class="sec-title">✍️ あなたの回答</div>';
      h += '<div class="user-info">👤 ' + esc(data.me.userName) + ' さん'
         + (data.myAnswers ? '<span class="muted small">（回答済み・修正できます）</span>' : '') + '</div>';
      h += '<div class="bulk"><span class="muted small">まとめて：</span>'
         + '<button type="button" class="bulk-btn" data-mark="〇">全部〇</button>'
         + '<button type="button" class="bulk-btn" data-mark="△">全部△</button>'
         + '<button type="button" class="bulk-btn" data-mark="×">全部×</button></div>';
      h += '<div id="ansList">';
      data.dates.forEach(function(d, i) {
        h += '<div class="q-item"><div class="q-date">' + esc(d) + '</div><div class="seg">';
        MARKS.forEach(function(m) {
          const sel = (myAnswers[i] === m) ? ' sel' : '';
          h += '<button type="button" class="seg-btn ' + markKey(m) + sel + '" data-idx="' + i + '" data-mark="' + m + '">' + m + '</button>';
        });
        h += '</div></div>';
      });
      h += '</div><div id="message"></div></div>';

      // ======== ③ みんなの回答 ========
      h += '<div class="card"><div class="sec-title">👥 みんなの回答</div>';
      if (total > 0) {
        h += '<div class="table-wrap"><table><thead><tr><th class="sticky">名前</th>';
        data.dates.forEach(function(d) { h += '<th>' + esc(d).replace(' ', '<br>') + '</th>'; });
        h += '</tr></thead><tbody>';
        data.allAnswers.forEach(function(ans) {
          const me = (ans.name === data.me.userName) ? ' class="me-row"' : '';
          h += '<tr' + me + '><td class="sticky">' + esc(ans.name) + '</td>';
