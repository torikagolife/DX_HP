  if (g === "05" || g === "06"){
    var n = parseInt(code, 10) % 10;   // 1,3,5,7,9=後方 2,4,6,8,0=前方
    if (/頚|頸/.test(t) || code === "43" || code === "53") return "02";
    if (code === "44" || code === "54") return "01";
    if (code === "45" || code === "55") return "03";
    return "04";
  }
  if (/肩/.test(t)) return "06";
  if (/肘/.test(t)) return "08";
  if (/手関節|手根|指|手/.test(t)) return "10";
  if (/膝/.test(t)) return "16";
  if (/足関節|アキレス/.test(t)) return "18";
  if (/足|趾|踵|外反母趾/.test(t)) return "19";
  if (/鎖骨/.test(t)) return "05";
  if (/前腕|橈骨|尺骨/.test(t)) return "09";
  if (/上腕/.test(t)) return "07";
  if (/大腿/.test(t)) return "15";
  if (/下腿|脛骨/.test(t)) return "17";
  if (/股/.test(t)) return "13";
  return "";
}

