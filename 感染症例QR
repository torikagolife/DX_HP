  if (!s.N0104 || !s.N0105) w.push("CSVに身長または体重がありません");
  if (!s.PID) w.push("患者番号から加工IDを作れませんでした");
  if (s.R0141 && s.R0141 !== "01" && s.R0303 === "02" && s.T0305 === "K1") w.push("糖尿病ありなのに、血糖が「未測定（糖尿病ではないため）」になっています");
  if (s.R0236 === "02" && !(s.C0237 || s.C0238 || s.C0239 || s.C0240)) w.push("輸血ありですが、種類が選ばれていません");
  if ((parseFloat(col(r, "自己血液輸血量")) || 0) > 0) w.push("CSVに自己血の輸血量があります。種類（術前貯血／術中回収／術後回収）を確認してください");
  return w;
}

// ============================================================
// QRの中身
//   KQ1/登録先/分類/シート/AG年齢/SX性別/OP手術日/項目名-値/...
//   英大文字・数字と / - . だけを使う（QRの英数字モードで小さく作れる）
// ============================================================
function qrString(P, sheet){
  var def = DEFS[P.defKey], s = P.st;
  var t = ["KQ1", def.reg, def.type, sheet.code];
  if (s.N0010) t.push("AG" + s.N0010);
  if (s.R0011) t.push("SX" + s.R0011.slice(1));
  if (s.D_OPE) t.push("OP" + s.D_OPE.replace(/-/g, ""));
  var n = 0;
  sheet.fields.forEach(function(f){
    if (f.when && !f.when(s)) return;
    if (f.kind === "radio" || f.kind === "textcode"){
      if (s[f.id]){ t.push(f.id + "-" + s[f.id]); n++; }
    } else if (f.kind === "num"){
      var v = String(s[f.id] || "").replace(/[^0-9.]/g, "");
      if (v){ t.push(f.id + "-" + v); n++; }
    } else if (f.kind === "date"){
      if (s[f.id]){
        var p = s[f.id].split("-");
        t.push(f.ids[0] + "-" + p[0], f.ids[1] + "-" + p[1], f.ids[2] + "-" + p[2]); n++;
      }
    } else if (f.kind === "pid"){
      var v2 = String(s[f.id] || "").replace(/[^0-9A-Za-z]/g, "");
      if (v2){ t.push(f.ids[0] + "-" + v2, f.ids[1] + "-" + v2); n++; }
    } else if (f.kind === "checks"){
      f.items.forEach(function(it){ t.push(it[0] + "-" + (s[it[0]] ? "1" : "0")); });
      n++;
    }
  });
  return { text:t.join("/").toUpperCase(), count:n };
}

// QRをSVGにする（どの大きさでも鮮明に印刷できるよう、拡大縮小できるSVGで作る）
function qrSvg(text){
  var qr = qrcode(0, "M");
  qr.addData(text, "Alphanumeric");
  qr.make();
  var n = qr.getModuleCount(), m = 4, size = n + m*2, d = "";
  for (var y=0;y<n;y++) for (var x=0;x<n;x++) if (qr.isDark(y, x)) d += "M" + (x+m) + " " + (y+m) + "h1v1h-1z";
  return '<svg viewBox="0 0 ' + size + ' ' + size + '" xmlns="http://www.w3.org/2000/svg" shape-rendering="crispEdges">' +
         '<rect width="' + size + '" height="' + size + '" fill="#fff"/><path d="' + d + '" fill="#000"/></svg>';
}

// ============================================================
// 入力用紙の描画
// ============================================================
var TAGNAME = { csv:"CSV", guess:"推定", init:"いつもの値" };
function tagOf(P, id){
  var s = P.src[id];
  return TAGNAME[s] ? '<span class="tag ' + s + '">' + TAGNAME[s] + '</span>' : "";
}

function renderField(P, f){
  var s = P.st;
  if (f.when && !f.when(s)) return "";
  var cls = "row" + (f.sub ? " sub" : "");
  var ct = "", need = false;
  var u = ' data-uid="' + P.uid + '" data-id="' + f.id + '"';

  if (f.kind === "radio" || f.kind === "textcode"){
    need = !s[f.id];
    ct = f.opts.map(function(o){
      return '<button type="button" class="opt' + (s[f.id] === o[0] ? " on" : "") + '"' + u + ' data-v="' + o[0] + '">' + esc(o[1]) + '</button>';
    }).join("");
    if (f.after) ct += f.after(s);
  } else if (f.kind === "checks"){
    ct = f.items.map(function(it){
      return '<button type="button" class="opt chk' + (s[it[0]] ? " on" : "") + '" data-uid="' + P.uid + '" data-chk="' + it[0] + '" data-grp="' + f.id + '">' + esc(it[1]) + '</button>';
    }).join("");
  } else if (f.kind === "num"){
    need = !s[f.id];
    ct = '<input class="num" inputmode="decimal"' + u + ' value="' + esc(s[f.id] || "") + '"><span class="unit">' + esc(f.unit || "") + '</span>';
  } else if (f.kind === "pid"){
    need = !s[f.id];
    ct = '<input class="txt"' + u + ' value="' + esc(s[f.id] || "") + '">';
  } else if (f.kind === "date"){
    need = !s[f.id];
    ct = '<input class="dt" type="date"' + u + ' value="' + esc(s[f.id] || "") + '">';
  } else if (f.kind === "action"){
    ct = '<button type="button" class="act" data-uid="' + P.uid + '" data-act="' + f.id + '">' + esc(f.btn) + '</button>' +
         '<span class="note scr">　全項目を「なし」にします（あとで個別に変更できます）</span>';
  } else if (f.kind === "show"){
    ct = esc(f.show(P));
  } else if (f.kind === "hand"){
    ct = esc(f.text);
  }
  if (f.note) ct += ' <span class="note">' + esc(f.note) + '</span>';
  if (need) cls += " need";
  var tagId = f.kind === "checks" ? f.id : f.id;
  return '<div class="' + cls + '"><div class="lb">' + esc(f.label) + tagOf(P, tagId) + '</div><div class="ct">' + ct + '</div></div>';
}

function renderPaper(P){
  var def = DEFS[P.defKey], r = P.r;
  var w = warningsOf(P);
  var html = '<article class="paper" id="paper' + P.uid + '">';
  html += '<div class="ptop"><div>' +
            '<h3>' + esc(def.title) + '</h3>' +
            '<div class="meta">術式：' + esc(opeName(r)) + '<br>病名：' + esc(diagName(r)) + '</div>' +
            '<div class="code1">コード1　' + esc(def.code1Hint) + '　<span></span>　<span class="note">登録後に控える</span></div>' +
          '</div><div class="ids">' +
            '手術日 <b>' + esc((P.st.D_OPE || "").replace(/-/g, "/")) + '</b><br>' +
            'ID <b>' + esc(patientId6(col(r, "患者番号"))) + '</b>　加工ID <b>' + esc(P.st.PID || "") + '</b><br>' +
            esc(P.st.N0010 || "") + '歳　' + (P.st.R0011 === "01" ? "男" : (P.st.R0011 === "02" ? "女" : "")) +
            '<div class="screen-only"><button class="btn rm" data-rm="' + P.uid + '">この用紙を外す</button></div>' +
          '</div></div>';
  if (w.length) html += '<div class="warns">' + w.map(function(x){ return '<div>' + esc(x) + '</div>'; }).join("") + '</div>';

  def.sheets.forEach(function(sh){
    html += '<section class="sec"><div class="main"><h4>' + esc(sh.title) + (sh.qr ? '<small>QRで入力</small>' : '<small>手書き</small>') + '</h4>';
    sh.fields.forEach(function(f){ html += renderField(P, f); });
    if (sh.fixed) html += '<div class="fixed">全例固定（ヘルパーが自動入力）：' + esc(sh.fixed) + '</div>';
    html += '</div>';
    if (sh.qr){
      var q = qrString(P, sh);
      html += '<div class="qr" id="qr' + P.uid + sh.code + '">' + qrSvg(q.text) +
              '<div class="cap">' + esc(sh.title) + 'シート<br>' + q.count + '項目</div></div>';
    }
    html += '</section>';
  });
  html += '<div class="note" style="margin-top:2mm">※ 印刷後に手書きで変えた内容はQRに入りません。J-DOSの画面で直接直してください。</div>';
  html += '</article>';
  return html;
}

function renderAll(){
  var box = $("papers");
  if (!patients.length){
    box.innerHTML = '<p class="empty">患者を選ぶと、ここに入力用紙が表示されます。○をクリックすると選べます。</p>';
    $("btnPrint").disabled = true;
    return;
  }
  box.innerHTML = patients.map(renderPaper).join("");
  $("btnPrint").disabled = false;
}
function rerender(P){
  var el = $("paper" + P.uid);
  if (!el) return renderAll();
  var tmp = document.createElement("div");
  tmp.innerHTML = renderPaper(P);
  el.replaceWith(tmp.firstChild);
}
// 文字入力中は再描画せず、QRと注意事項だけ更新する（カーソルが飛ばないように）
function refreshQr(P){
  var def = DEFS[P.defKey];
  def.sheets.forEach(function(sh){
    if (!sh.qr) return;
    var box = $("qr" + P.uid + sh.code);
    if (!box) return;
    var q = qrString(P, sh);
    box.innerHTML = qrSvg(q.text) + '<div class="cap">' + esc(sh.title) + 'シート<br>' + q.count + '項目</div>';
  });
}
function patientByUid(uid){
  uid = Number(uid);
  for (var i=0;i<patients.length;i++) if (patients[i].uid === uid) return patients[i];
  return null;
}

// 用紙上の操作（イベントは1か所でまとめて受ける）
$("papers").addEventListener("click", function(e){
  var b = e.target.closest("button");
  if (!b) return;
  if (b.dataset.rm){
    patients = patients.filter(function(p){ return p.uid !== Number(b.dataset.rm); });
    renderAll(); return;
  }
  var P = patientByUid(b.dataset.uid);
  if (!P) return;
  if (b.dataset.act){
    var f = findField(DEFS[P.defKey], b.dataset.act);
    if (f && f.run) f.run(P);
    rerender(P); return;
  }
  if (b.dataset.chk){
    P.st[b.dataset.chk] = !P.st[b.dataset.chk];
    P.src[b.dataset.grp] = "user";
    rerender(P); return;
  }
  if (b.dataset.id){
    var id = b.dataset.id, v = b.dataset.v;
    if (P.st[id] === v){ delete P.st[id]; delete P.src[id]; }   // もう一度押すと選択解除
    else setVal(P, id, v, "user");
    rerender(P);
  }
});
$("papers").addEventListener("input", function(e){
  var el = e.target;
  if (!el.dataset || !el.dataset.uid) return;
  var P = patientByUid(el.dataset.uid);
  if (!P) return;
  var v = el.value.trim();
  if (v) { P.st[el.dataset.id] = v; P.src[el.dataset.id] = "user"; }
  else   { delete P.st[el.dataset.id]; delete P.src[el.dataset.id]; }
  refreshQr(P);
});
// 入力欄から離れたら全体を描き直す（注意事項・黄色表示の更新）
$("papers").addEventListener("change", function(e){
  var el = e.target;
  if (!el.dataset || !el.dataset.uid) return;
  var P = patientByUid(el.dataset.uid);
  if (P) rerender(P);
});

// ============================================================
// CSV読み込みと患者選択
// ============================================================
function loadFile(file){
  var fr = new FileReader();
  fr.onload = function(){
    var rows = parseCSV(decodeBytes(fr.result));
    if (!rows.length){ alert("CSVが空です"); return; }
    var head = rows[0].map(function(h){ return String(h).replace(/^\s*\d+\s*:/, "").trim(); });
    if (head.indexOf("患者番号") < 0 || head.indexOf("手術日") < 0){
      alert("手術予定CSVの形式ではないようです（「患者番号」「手術日」の列が見つかりません）");
      return;
    }
    recs = [];
    for (var i=1;i<rows.length;i++){
      if (rows[i].length < 5) continue;
      var o = {};
      head.forEach(function(h, k){ o[h] = rows[i][k]; });
      if (!col(o, "患者番号")) continue;
      o.__key = col(o, "手術番号") || ("row" + i);
      recs.push(o);
    }
    recs.sort(function(a, b){ return (col(a, "手術日") + col(a, "開始時刻")).localeCompare(col(b, "手術日") + col(b, "開始時刻")); });
    picked = {};
    $("csvInfo").textContent = file.name + "（" + recs.length + "件）";
    $("drop").hidden = true;
    $("pickArea").hidden = false;
    var ds = recs.map(function(r){ return isoOf(ymdParts(col(r, "手術日"))); }).filter(Boolean).sort();
    $("fFrom").value = ds[0] || "";
    $("fTo").value = ds[ds.length-1] || "";
    renderPick();
  };
  fr.readAsArrayBuffer(file);
}

function filtered(){
  var from = $("fFrom").value, to = $("fTo").value, w = $("fWord").value.trim(), cand = $("fCand").checked;
  return recs.filter(function(r){
    var d = isoOf(ymdParts(col(r, "手術日")));
    if (from && d < from) return false;
    if (to && d > to) return false;
    if (cand && !isJointCandidate(r)) return false;
    if (w){
      var hay = patientId6(col(r, "患者番号")) + " " + opeName(r) + " " + diagName(r) + " " + toZenkakuKana(col(r, "氏名（カナ）"));
      if (hay.indexOf(w) < 0) return false;
    }
    return true;
  });
}
function renderPick(){
  var list = filtered();
  $("pickBody").innerHTML = list.map(function(r){
    var k = r.__key, on = !!picked[k];
    var age = ageAt(ymdParts(col(r, "生年月日")), ymdParts(col(r, "手術日")));
    return '<tr class="' + (isJointCandidate(r) ? "cand " : "") + (on ? "sel" : "") + '" data-key="' + esc(k) + '">' +
      '<td><input type="checkbox" data-key="' + esc(k) + '"' + (on ? " checked" : "") + ' aria-label="選択"></td>' +
      '<td>' + esc(col(r, "手術日").replace(/\./g, "/")) + '</td>' +
      '<td>' + esc(patientId6(col(r, "患者番号"))) + '</td>' +
      '<td>' + esc(toZenkakuKana(col(r, "氏名（カナ）"))) + '</td>' +
      '<td>' + esc(col(r, "性別")) + '</td>' +
      '<td>' + esc(age) + '</td>' +
      '<td class="wrap">' + esc(opeName(r)) + '</td>' +
      '<td class="wrap">' + esc(diagName(r)) + '</td>' +
      '<td>' + esc(col(r, "執刀医")) + '</td></tr>';
  }).join("");
  var n = Object.keys(picked).length;
  $("pickCount").textContent = list.length + "件表示／" + n + "人選択中";
  $("btnMake").disabled = n === 0;
}
$("pickBody").addEventListener("click", function(e){
  var tr = e.target.closest("tr");
  if (!tr) return;
  var k = tr.dataset.key;
  if (e.target.tagName !== "INPUT"){
    var cb = tr.querySelector("input"); cb.checked = !cb.checked;
  }
  if (tr.querySelector("input").checked) picked[k] = true; else delete picked[k];
  renderPick();
});
["fFrom","fTo","fWord","fCand"].forEach(function(id){ $(id).addEventListener("input", renderPick); });

$("btnMake").addEventListener("click", function(){
  var defKey = $("reg").value;
  var have = {};
  patients.forEach(function(p){ have[p.r.__key + "|" + p.defKey] = true; });
  recs.forEach(function(r){
    if (picked[r.__key] && !have[r.__key + "|" + defKey]) patients.push(makePatient(r, defKey));
  });
  picked = {};
  renderPick();
  renderAll();
  var first = document.querySelector(".paper");
  if (first) first.scrollIntoView({ behavior:"smooth", block:"start" });
});

$("btnCsv").addEventListener("click", function(){ $("file").click(); });
$("file").addEventListener("change", function(){ if (this.files[0]) loadFile(this.files[0]); this.value = ""; });
var drop = $("drop");
["dragenter","dragover"].forEach(function(t){ document.addEventListener(t, function(e){ e.preventDefault(); drop.classList.add("over"); }); });
["dragleave","drop"].forEach(function(t){ document.addEventListener(t, function(e){ e.preventDefault(); drop.classList.remove("over"); }); });
document.addEventListener("drop", function(e){
  var f = e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files[0];
  if (f) loadFile(f);
});
$("btnPrint").addEventListener("click", function(){
  var miss = patients.filter(function(P){ return document.querySelector("#paper" + P.uid + " .row.need"); }).length;
  if (miss && !confirm("黄色（未選択）の項目が残っている用紙が " + miss + " 枚あります。\n未選択の項目はQRに入らず、J-DOSで手入力になります。印刷しますか？")) return;
  window.print();
});
