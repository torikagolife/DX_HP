    need = !s[f.id];
    ct = '<input class="dt" type="date"' + u + ' value="' + esc(s[f.id] || "") + '">';
  } else if (f.kind === "action"){
    ct = '<button type="button" class="act" data-uid="' + P.uid + '" data-act="' + f.id + '">' + esc(f.btn) + '</button>' +
         '<span class="note scr">　全項目を「なし」にします（あとで個別に変更できます）</span>';
  } else if (f.kind === "show"){
    ct = esc(f.show(P));
  } else if (f.kind === "hand"){
    ct = esc(f.text);
  }
  if (f.note) ct += ' <span class="note">' + esc(f.note) + '</span>';
  if (need) cls += " need";
  return '<div class="' + cls + '"><div class="lb">' + esc(f.label) + tagOf(P, f.id) + '</div><div class="ct">' + ct + '</div></div>';
}

function qrBox(P, sh){
  var q = qrString(P, sh);
  return qrSvg(q.text) + '<div class="cap">' + esc(sh.title) + '<br>' + q.count + '項目</div>';
}
function renderPaper(P){
  var def = DEFS[P.defKey], r = P.r, s = P.st;
  var w = def.warnings(P);
  var html = '<article class="paper" id="paper' + P.uid + '">';
  html += '<div class="ptop"><div>' +
            '<h3>' + esc(def.title) + '</h3>' +
            '<div class="meta">術式：' + esc(opeName(r)) + '<br>病名：' + esc(diagName(r)) + '<br>執刀医：' + esc(col(r, "執刀医")) + '</div>' +
            '<div class="code1">コード1　<b>' + esc(def.code1Head) + '</b> ' + new Array(def.code1Len + 1).join('<i class="box"></i>') + '　<span class="note">登録後に控える</span></div>' +
          '</div><div class="ids">' +
            '手術日 <b>' + esc((s.OPD || "").replace(/-/g, "/")) + '</b><br>' +
            'ID <b>' + esc(patientId6(col(r, "患者番号"))) + '</b>　加工ID <b>' + esc(s.PID || "") + '</b><br>' +
            esc(s.AGE || "") + '歳　' + (s.SEX === "01" ? "男" : (s.SEX === "02" ? "女" : "")) +
            '<div class="screen-only"><button class="btn rm" data-rm="' + P.uid + '">この用紙を外す</button></div>' +
          '</div></div>';
  if (w.length) html += '<div class="warns">' + w.map(function(x){ return '<div>' + esc(x) + '</div>'; }).join("") + '</div>';

  def.sheets(P).forEach(function(sh){
    html += '<section class="sec"><div class="main"><h4>' + esc(sh.title) + (sh.qr ? '<small>QRで入力</small>' : '<small>手書き</small>') + '</h4>';
    sh.fields.forEach(function(f){ html += renderField(P, f); });
    if (sh.fixed) html += '<div class="fixed">全例固定（ヘルパーが自動入力）：' + esc(sh.fixed) + '</div>';
    html += '</div>';
    if (sh.qr) html += '<div class="qr" id="qr' + P.uid + sh.code + (sh.site || "") + '">' + qrBox(P, sh) + '</div>';
    html += '</section>';
  });
  html += '<div class="note" style="margin-top:2mm">※ 印刷後に手書きで変えた内容はQRに入りません。登録サイトの画面で直接直してください。</div>';
  html += '</article>';
  return html;
}
function renderAll(){
  var box = $("papers");
  if (!patients.length){
    box.innerHTML = '<p class="empty">患者を選ぶと、ここに入力用紙が表示されます。○をクリックすると選べます。</p>';
    $("btnPrint").disabled = true;
    return;
  }
  box.innerHTML = patients.map(renderPaper).join("");
  $("btnPrint").disabled = false;
}
function rerender(P){
  var el = $("paper" + P.uid);
  if (!el) return renderAll();
  var tmp = document.createElement("div");
  tmp.innerHTML = renderPaper(P);
  el.replaceWith(tmp.firstChild);
}
function refreshQr(P){
  DEFS[P.defKey].sheets(P).forEach(function(sh){
    if (!sh.qr) return;
    var box = $("qr" + P.uid + sh.code + (sh.site || ""));
    if (box) box.innerHTML = qrBox(P, sh);
  });
}
function patientByUid(uid){
  uid = Number(uid);
  for (var i=0;i<patients.length;i++) if (patients[i].uid === uid) return patients[i];
  return null;
}

$("papers").addEventListener("click", function(e){
  var b = e.target.closest("button");
  if (!b) return;
  if (b.dataset.rm){
    patients = patients.filter(function(p){ return p.uid !== Number(b.dataset.rm); });
    renderAll(); return;
  }
  var P = patientByUid(b.dataset.uid);
  if (!P) return;
  if (b.dataset.act){
    var f = findField(P, b.dataset.act);
    if (f && f.keys) f.keys.forEach(function(k){ setVal(P, k, "01", "user"); });
    rerender(P); return;
  }
  if (b.dataset.chk){
    P.st[b.dataset.chk] = !P.st[b.dataset.chk];
    P.src[b.dataset.grp] = "user";
    rerender(P); return;
  }
  if (b.dataset.id){
    var id = b.dataset.id, v = b.dataset.v;
    if (P.st[id] === v){ delete P.st[id]; delete P.src[id]; var d = DEFS[P.defKey]; if (d.onSet) d.onSet(P, id, ""); }
    else setVal(P, id, v, "user");
    rerender(P);
  }
});
$("papers").addEventListener("input", function(e){
  var el = e.target;
  if (!el.dataset || !el.dataset.uid) return;
  var P = patientByUid(el.dataset.uid);
  if (!P) return;
  var v = el.value.trim();
  if (v){ P.st[el.dataset.id] = v; P.src[el.dataset.id] = "user"; }
  else { delete P.st[el.dataset.id]; delete P.src[el.dataset.id]; }
  refreshQr(P);
});
$("papers").addEventListener("change", function(e){
  var el = e.target;
  if (!el.dataset || !el.dataset.uid) return;
  var P = patientByUid(el.dataset.uid);
  if (P) rerender(P);
});

// ============================================================
// CSV読み込みと患者選択
// ============================================================
function loadFile(file){
  var fr = new FileReader();
  fr.onload = function(){
    var rows = parseCSV(decodeBytes(fr.result));
    if (!rows.length){ alert("CSVが空です"); return; }
    var head = rows[0].map(function(h){ return String(h).replace(/^\s*\d+\s*:/, "").trim(); });
    if (head.indexOf("患者番号") < 0 || head.indexOf("手術日") < 0){
      alert("手術予定CSVの形式ではないようです（「患者番号」「手術日」の列が見つかりません）");
      return;
    }
    recs = [];
    for (var i=1;i<rows.length;i++){
      if (rows[i].length < 5) continue;
      var o = {};
      head.forEach(function(h, k){ o[h] = rows[i][k]; });
      if (!col(o, "患者番号")) continue;
      o.__key = col(o, "手術番号") || ("row" + i);
      recs.push(o);
    }
    recs.sort(function(a, b){ return (col(a, "手術日") + col(a, "開始時刻")).localeCompare(col(b, "手術日") + col(b, "開始時刻")); });
    picked = {};
    $("csvInfo").textContent = file.name + "（" + recs.length + "件）";
    $("drop").hidden = true;
    $("pickArea").hidden = false;
    var ds = recs.map(function(r){ return isoOf(ymdParts(col(r, "手術日"))); }).filter(Boolean).sort();
    $("fFrom").value = ds[0] || "";
    $("fTo").value = ds[ds.length-1] || "";
    renderPick();
  };
  fr.readAsArrayBuffer(file);
}
function curDef(){ return DEFS[$("reg").value]; }
function filtered(){
  var def = curDef();
  var from = $("fFrom").value, to = $("fTo").value, w = $("fWord").value.trim(), cand = def.isCand && $("fCand").checked;
  return recs.filter(function(r){
    var d = isoOf(ymdParts(col(r, "手術日")));
    if (from && d < from) return false;
    if (to && d > to) return false;
    if (cand && !def.isCand(r)) return false;
    if (w){
      var hay = patientId6(col(r, "患者番号")) + " " + opeName(r) + " " + diagName(r) + " " + toZenkakuKana(col(r, "氏名（カナ）")) + " " + col(r, "執刀医");
      if (hay.indexOf(w) < 0) return false;
    }
    return true;
  });
}
function renderPick(){
  var def = curDef();
  $("fCandWrap").hidden = !def.isCand;
  $("fCandLabel").textContent = def.candLabel;
  $("candNote").textContent = def.isCand ? "左端に青線がある行は、術式から見た候補です。最終判断は人が行ってください。" : "対象の患者を選んでください。";
  var list = filtered();
  $("pickBody").innerHTML = list.map(function(r){
    var k = r.__key, on = !!picked[k];
    var age = ageAt(ymdParts(col(r, "生年月日")), ymdParts(col(r, "手術日")));
    return '<tr class="' + (def.isCand && def.isCand(r) ? "cand " : "") + (on ? "sel" : "") + '" data-key="' + esc(k) + '">' +
      '<td><input type="checkbox" data-key="' + esc(k) + '"' + (on ? " checked" : "") + ' aria-label="選択"></td>' +
      '<td>' + esc(col(r, "手術日").replace(/\./g, "/")) + '</td>' +
      '<td>' + esc(patientId6(col(r, "患者番号"))) + '</td>' +
      '<td>' + esc(toZenkakuKana(col(r, "氏名（カナ）"))) + '</td>' +
      '<td>' + esc(col(r, "性別")) + '</td>' +
      '<td>' + esc(age) + '</td>' +
      '<td class="wrap">' + esc(opeName(r)) + '</td>' +
      '<td class="wrap">' + esc(diagName(r)) + '</td>' +
      '<td>' + esc(col(r, "執刀医")) + '</td></tr>';
  }).join("");
  var n = Object.keys(picked).length;
  $("pickCount").textContent = list.length + "件表示／" + n + "人選択中";
  $("btnMake").disabled = n === 0;
}
$("pickBody").addEventListener("click", function(e){
  var tr = e.target.closest("tr");
  if (!tr) return;
  var k = tr.dataset.key;
  if (e.target.tagName !== "INPUT"){ var cb = tr.querySelector("input"); cb.checked = !cb.checked; }
  if (tr.querySelector("input").checked) picked[k] = true; else delete picked[k];
  renderPick();
});
["fFrom","fTo","fWord","fCand"].forEach(function(id){ $(id).addEventListener("input", renderPick); });
$("reg").addEventListener("change", function(){ if (recs.length) renderPick(); });

$("btnMake").addEventListener("click", function(){
  var defKey = $("reg").value, have = {};
  patients.forEach(function(p){ have[p.r.__key + "|" + p.defKey] = true; });
  recs.forEach(function(r){
    if (picked[r.__key] && !have[r.__key + "|" + defKey]) patients.push(makePatient(r, defKey));
  });
  picked = {};
  renderPick();
  renderAll();
  var first = document.querySelector(".paper");
  if (first) first.scrollIntoView({ behavior:"smooth", block:"start" });
});


$("btnCsv").addEventListener("click", function(){ $("file").click(); });
$("file").addEventListener("change", function(){ if (this.files[0]) loadFile(this.files[0]); this.value = ""; });
var drop = $("drop");
drop.addEventListener("click", function(){ $("file").click(); });
drop.addEventListener("keydown", function(e){ if (e.key === "Enter" || e.key === " "){ e.preventDefault(); $("file").click(); } });
["dragenter","dragover"].forEach(function(t){ document.addEventListener(t, function(e){ e.preventDefault(); drop.classList.add("over"); }); });
["dragleave","drop"].forEach(function(t){ document.addEventListener(t, function(e){ e.preventDefault(); drop.classList.remove("over"); }); });
document.addEventListener("drop", function(e){
  var f = e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files[0];
  if (f) loadFile(f);
});
$("btnPrint").addEventListener("click", function(){
  var miss = patients.filter(function(P){ return document.querySelector("#paper" + P.uid + " .row.need"); }).length;
  if (miss && !confirm("黄色（未選択）の項目が残っている用紙が " + miss + " 枚あります。\n未選択の項目はQRに入らず、登録サイトで手入力になります。印刷しますか？")) return;
  window.print();
});
renderAll();
</script>
